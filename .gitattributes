# Line endings are LF in the repository and LF in every working tree.
#
# Without a rule here, only `.ts` and `.tsx` were normalized, so any Windows
# tool that rewrote a `.md`, `.json`, `.rs` or `.yml` file with CRLF left it
# permanently "modified" in `git status` — 486 files at once, on 2026-08-29,
# none of them actually changed. That noise is worse than a wrong default: it
# hides the files that really are modified.
#
# `text=auto` still leaves binaries alone; the more specific rules below win,
# because for any attribute the last matching pattern is the one that applies.
* text=auto eol=lf

*.ts text diff
*.tsx text diff

# tauri-build embeds permission TOML prose into gen/schemas/*.json; keep the
# sources LF on Windows checkouts so regeneration is byte-identical across
# platforms instead of flip-flopping \r\n into the committed JSON.
src-tauri/plugins/*/permissions/**/*.toml text eol=lf
src-tauri/gen/schemas/*.json text eol=lf
src-tauri/tauri.windows.conf.json text eol=lf
# sqlx migration checksums cover exact bytes; checkout conversion would make an
# already-applied migration appear modified and abort application startup.
src-tauri/migrations/*.sql text eol=lf
# cmd.exe reads batch files byte by byte and mis-handles labels in an LF-only
# file; scripts/hooks/dev-tool.cmd relies on them.
*.cmd text eol=crlf
