#!/usr/bin/python3
"""bench-digest SCOPE PATH...: the SHA-256 of each file, one "<digest> <path>"
line per path in order, "-" where sha256sum would print no digest.

Readiness checks report the digests of large pinned executables and of the
renderer tree many times an attempt. A regular file whose full identity
(resolved path, device, inode, size, modify and change times, owner, mode and
link count) is the one recorded beside its digest is not read again; every
other file is read whole, and a file that changes while it is read is
reported but not recorded. The record lives in a root-only directory on
/run, which empties at every WSL start, one file per SCOPE (status, browser)
holding only that scope's last paths. Only root writes it, and a damaged or
unprotected record is a cold pass. The Linux text proofs keep their digests
the same way.
"""
import hashlib
import json
import os
import re
import stat
import sys
import tempfile

CACHE = '/run/distill-bench-digests'
LIMIT = 1 << 20


def identity(real, info):
    return [real, info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns,
            info.st_ctime_ns, info.st_uid, info.st_gid, info.st_mode, info.st_nlink]


def protected(info, directory=False):
    kind = stat.S_ISDIR if directory else stat.S_ISREG
    return (kind(info.st_mode) and info.st_uid == 0 and not info.st_mode & 0o077 and
            (directory or info.st_nlink == 1))


def valid(digest):
    return isinstance(digest, str) and re.fullmatch('[0-9a-f]{64}', digest) is not None


def load(record):
    """The recorded digests, or None where no record may be kept."""
    try:
        os.mkdir(CACHE, 0o700)
    except FileExistsError:
        pass
    if not protected(os.lstat(CACHE), directory=True):
        return None
    try:
        fd = os.open(record, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return {}
    with os.fdopen(fd) as file:
        info = os.fstat(file.fileno())
        if not protected(info) or info.st_size > LIMIT:
            return {}
        try:
            saved = json.load(file)
        except (ValueError, UnicodeError):
            return {}
    return saved if isinstance(saved, dict) else {}


def save(record, entries):
    payload = json.dumps(entries, sort_keys=True)
    if len(payload) > LIMIT:
        return
    fd, temporary = tempfile.mkstemp(prefix='.digests-', dir=CACHE)
    try:
        with os.fdopen(fd, 'w') as file:
            file.write(payload)
        os.chmod(temporary, 0o600)
        os.replace(temporary, record)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def digest(path, entries, kept):
    real = os.path.realpath(path)
    with open(path, 'rb') as file:
        before = os.fstat(file.fileno())
        key = identity(real, before)
        entry = entries.get(path)
        if (stat.S_ISREG(before.st_mode) and isinstance(entry, dict) and
                entry.get('identity') == key and valid(entry.get('sha256'))):
            value = entry['sha256']
        else:
            hashed = hashlib.sha256()
            while chunk := file.read(1 << 20):
                hashed.update(chunk)
            value = hashed.hexdigest()
        if stat.S_ISREG(before.st_mode) and identity(real, os.fstat(file.fileno())) == key:
            kept[path] = {'identity': key, 'sha256': value}
    return value


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in ('status', 'browser'):
        print('bench-digest: usage: bench-digest status|browser PATH...', file=sys.stderr)
        return 64
    record = CACHE + '/' + sys.argv[1] + '.json'
    entries = None
    if os.geteuid() == 0:
        try:
            entries = load(record)
        except OSError:
            entries = None
    kept = {}
    for path in sys.argv[2:]:
        try:
            value = digest(path, entries or {}, kept)
        except OSError:
            value = '-'
        print(value, path)
    if entries is not None and kept != entries:
        try:
            save(record, kept)
        except OSError:
            pass
    return 0


if __name__ == '__main__':
    sys.exit(main())
