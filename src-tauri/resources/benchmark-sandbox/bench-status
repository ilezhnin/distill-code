#!/bin/bash
# bench-status: what the host reads before it plans a repository case, one
# "key value" pair per line: the digest of every sandbox file, the tool
# versions and the Kimi sign-ins the sandbox keeps (every other provider runs
# on leases staged per session). Presence is not proof that the provider
# accepts a credential or can refresh it.
set -uo pipefail
# Admission can be the first command after WSL starts. Join the boot helper's
# lock and finish initialization before reporting readiness, once.
if [[ -z ${DISTILL_BENCH_CONTROL:-} ]]; then
  /usr/local/sbin/bench-net >&2 || exit $?
  exec /usr/local/sbin/bench-budget control -- /usr/bin/env DISTILL_BENCH_CONTROL=1 /bin/bash "$0" "$@"
fi
/usr/local/sbin/bench-budget status || exit $?
helpers=(/usr/local/sbin/bench-* /etc/wsl.conf)
browser=()
for file in /opt/distill-browser/runtime.json /usr/local/lib/distill/benchmark-browser-worker.mjs; do
  [[ ! -f $file ]] || browser+=("$file")
done
binaries=(/usr/local/bin/node /usr/bin/git /opt/distill-tools/bin/*)
# Executables a tool keeps on its own sessions' PATH alone (Z.ai's ripgrep).
for binary in /opt/distill-tools/zai/bin/*; do
  [[ -f $binary ]] && binaries+=("$binary")
done
# Rehash the installed entrypoint of every tool file, not its
# provisioning-time receipt: the last word of the launcher's `exec ... "$@"`.
declare -A entrypoint=()
launched() {
  local line found=
  [[ -f $1 ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ ^exec\ (.*)\ \"\$@\"$ ]]; then
      found=${BASH_REMATCH[1]}
      found=${found##*[[:space:]]}
    fi
  done <"$1"
  printf '%s' "$found"
}
tools=()
for manifest in /opt/distill-tools/*/manifest; do
  [[ -f $manifest ]] || continue
  while read -r tool kind name recorded; do
    [[ $kind == file ]] || continue
    launcher=/opt/distill-tools/bin/$name
    [[ -n ${entrypoint[$launcher]+set} ]] || entrypoint[$launcher]=$(launched "$launcher")
    tools+=("${entrypoint[$launcher]}")
  done <"$manifest"
done
# One pass over every digest below. bench-digest reads a file again only
# when its identity changed since the last pass (see that helper).
declare -A digest=()
while read -r sum path; do
  [[ -n $path && $sum != - ]] && digest[$path]=$sum
done < <(/usr/local/sbin/bench-digest status "${helpers[@]}" "${browser[@]}" "${binaries[@]}" "${tools[@]}")
# The digest of a path, empty where it has none (as sha256sum printed none).
for file in "${helpers[@]}"; do
  echo "file ${file##*/} ${digest[$file]:-}"
done
for file in "${browser[@]}"; do
  name=${file##*/}
  [[ $name != runtime.json ]] || name=browser-runtime.json
  echo "file $name ${digest[$file]:-}"
done
echo "node $(node --version 2>/dev/null)"
version=$(git --version 2>/dev/null)
read -r _ _ version _ <<<"$version"
echo "git ${version:-}"
for binary in "${binaries[@]}"; do
  echo "binary $binary ${digest[$binary]:-}"
done
echo "netns $(if ip netns exec bench ip -4 route show default 2>/dev/null | grep -q 10.231.0.1; then echo up; else echo down; fi)"
for manifest in /opt/distill-tools/*/manifest; do
  [[ -f $manifest ]] || continue
  while read -r tool kind name recorded; do
    if [[ $kind == file ]]; then
      launcher=/opt/distill-tools/bin/$name
      [[ -n ${entrypoint[$launcher]+set} ]] || entrypoint[$launcher]=$(launched "$launcher")
      target=${entrypoint[$launcher]}
      echo "tool $tool file $name ${target:+${digest[$target]:-}}"
    else
      echo "tool $tool $kind $name"
    fi
  done <"$manifest"
done
# Credential copies of attempts whose save failed, kept aside by bench-clean.
unsaved=$(find /srv/bench/auth-unsaved -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
((unsaved == 0)) || echo "auth-unsaved $unsaved"
for account in /home/candidate/accounts/*/*; do
  [[ -d $account ]] || continue
  provider=${account##*/}
  id=${account%/*}
  id=${id##*/}
  if [[ $provider != kimi ]]; then
    # Claude, Codex, Grok and Z.ai sessions run on leases of the Distill
    # app's sign-in staged per session: a grant left here from before is
    # used by nothing and waits for `bench-auth retire`.
    echo "grant-left $provider $id"
    continue
  fi
  # Refreshes bench-auth could not settle, kept for the operator.
  conflicts=/var/lib/distill-bench/auth-conflicts/$id/$provider
  if [[ -d $conflicts ]]; then
    count=$(find "$conflicts" -mindepth 2 -maxdepth 2 -name conflict.json 2>/dev/null | wc -l)
    ((count == 0)) || echo "account-conflict $provider $id $count"
  fi
  signed=no
  [[ -n $(find "$account/credentials" -type f -size +0c -print -quit 2>/dev/null) ]] && signed=yes
  echo "account $provider $id $signed"
  # Kimi records no expiry the host reads.
  echo "account-health $provider $id unknown $([[ $signed == yes ]] && echo unknown || echo missing) -"
done
