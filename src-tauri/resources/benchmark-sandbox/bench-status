#!/bin/bash
# bench-status: what the host reads before it plans a repository case, one
# "key value" pair per line: the digest of every sandbox file, the tool
# versions and the signed-in provider accounts.
set -uo pipefail
# Admission can be the first command after WSL starts. Join the boot helper's
# lock and finish initialization before reporting readiness.
/usr/local/sbin/bench-net >&2 || exit $?
for file in /usr/local/sbin/bench-* /etc/wsl.conf; do
  echo "file $(basename "$file") $(sha256sum "$file" | cut -d' ' -f1)"
done
echo "node $(node --version 2>/dev/null)"
echo "git $(git --version 2>/dev/null | cut -d' ' -f3)"
for binary in /usr/local/bin/node /usr/bin/git /opt/distill-tools/bin/*; do
  echo "binary $binary $(sha256sum "$binary" 2>/dev/null | cut -d' ' -f1)"
done
echo "netns $(if ip netns exec bench ip -4 route show default 2>/dev/null | grep -q 10.231.0.1; then echo up; else echo down; fi)"
for manifest in /opt/distill-tools/*/manifest; do
  [[ -f $manifest ]] || continue
  while read -r tool kind name recorded; do
    if [[ $kind == file ]]; then
      # Rehash the installed entrypoint, not its provisioning-time receipt.
      launcher=/opt/distill-tools/bin/$name
      target=$(sed -n 's/^exec \(.*\) "\$@"$/\1/p' "$launcher" | awk '{print $NF}')
      digest=$(sha256sum "$target" 2>/dev/null | cut -d' ' -f1)
      echo "tool $tool file $name $digest"
    else
      echo "tool $tool $kind $name"
    fi
  done <"$manifest"
done
for account in /home/candidate/accounts/*/*; do
  [[ -d $account ]] || continue
  provider=$(basename "$account")
  id=$(basename "$(dirname "$account")")
  signed=no
  case $provider in
    claude) [[ -s $account/.credentials.json ]] && signed=yes ;;
    codex) [[ -s $account/auth.json ]] && signed=yes ;;
    grok) [[ -s $account/auth.json ]] && signed=yes ;;
    kimi) [[ -n $(find "$account/credentials" -type f -size +0c -print -quit 2>/dev/null) ]] && signed=yes ;;
  esac
  echo "account $provider $id $signed"
done
