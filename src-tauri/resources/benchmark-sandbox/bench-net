#!/bin/sh
# Brings up, once per boot, what every benchmark run stands in: the "bench"
# network namespace (a veth pair with NAT to eth0 and egress only to the
# public internet; every private, link-local and loopback range is rejected,
# so nothing inside reaches the Windows host, the local network or another
# WSL distribution, which all share this VM's network namespace) and the
# parent cgroup with memory and process controllers.
set -eu
# WSL's boot command does not inherit an interactive root shell's PATH.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Every benchmark run, network and status calls this. Once this boot has
# finished setup (the marker names the boot; /run empties at every WSL start)
# and the namespace, its veth, the control group and the reaper bench-budget
# setup starts still stand, there is nothing to do: return without starting a
# process.
ready=/run/distill-bench-net.ready
if [ -f "$ready" ] && [ -e /run/netns/bench ] && [ -e /sys/class/net/bench0 ] \
  && [ -d /sys/fs/cgroup/distill-bench/control ] && [ -f /run/distill-bench-reaper.pid ]; then
  read -r boot </proc/sys/kernel/random/boot_id
  read -r marked <"$ready" || marked=
  read -r reaper </run/distill-bench-reaper.pid || reaper=
  if [ "$marked" = "$boot" ] && [ -n "$reaper" ] && [ -d "/proc/$reaper" ]; then
    exit 0
  fi
fi
mkdir -p /run/lock
exec 9>/run/lock/distill-bench-net
flock 9
# The first distribution to boot cannot depend on another distro's systemd
# enabling these controllers on the shared cgroup root.
if [ -f /var/lib/distill-bench/scratch.ext4 ]; then
  /usr/local/sbin/bench-budget mount-scratch
fi
/usr/local/sbin/bench-budget setup
# The VM's network namespace outlives this distribution's restarts, so a
# leftover half (a veth without its namespace) is torn down and rebuilt.
if ip netns exec bench ip -4 route show default 2>/dev/null | grep -q 10.231.0.1; then
  cat /proc/sys/kernel/random/boot_id >"$ready"
  exit 0
fi
ip link del bench0 2>/dev/null || true
ip netns del bench 2>/dev/null || true
ip netns add bench
ip link add bench0 type veth peer name bench1
ip link set bench1 netns bench
ip addr add 10.231.0.1/30 dev bench0
ip link set bench0 up
ip netns exec bench ip addr add 10.231.0.2/30 dev bench1
ip netns exec bench ip link set bench1 up
ip netns exec bench ip link set lo up
ip netns exec bench sysctl -q -w net.ipv6.conf.all.disable_ipv6=1
sysctl -q -w net.ipv4.ip_forward=1
iptables -N DISTILL-BENCH 2>/dev/null || iptables -F DISTILL-BENCH
for range in 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 \
  172.16.0.0/12 192.0.0.0/24 192.168.0.0/16 198.18.0.0/15 224.0.0.0/3; do
  iptables -A DISTILL-BENCH -d "$range" -j REJECT
done
iptables -A DISTILL-BENCH -o eth0 -j ACCEPT
iptables -A DISTILL-BENCH -j REJECT
iptables -C FORWARD -i bench0 -j DISTILL-BENCH 2>/dev/null ||
  iptables -I FORWARD -i bench0 -j DISTILL-BENCH
iptables -C FORWARD -o bench0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null ||
  iptables -I FORWARD -o bench0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
# Nothing inside may open a connection to this namespace's own services.
iptables -C INPUT -i bench0 -j DROP 2>/dev/null || iptables -I INPUT -i bench0 -j DROP
iptables -t nat -C POSTROUTING -s 10.231.0.0/30 -o eth0 -j MASQUERADE 2>/dev/null ||
  iptables -t nat -A POSTROUTING -s 10.231.0.0/30 -o eth0 -j MASQUERADE
mkdir -p /etc/netns/bench
printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' >/etc/netns/bench/resolv.conf
# Publish readiness only after every limit and firewall rule is installed.
# A failed setup has no default route and is rebuilt on the next invocation.
ip netns exec bench ip route add default via 10.231.0.1
cat /proc/sys/kernel/random/boot_id >"$ready"
