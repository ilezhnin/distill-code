#!/bin/bash
# bench-login kimi ACCOUNT-ID
# Signs the Kimi CLI in inside the sandbox, for the Distill account
# ACCOUNT-ID, into /home/candidate/accounts/ACCOUNT-ID/kimi. Kimi keeps its
# own sandbox-only sign-in, never a copy of the user's Kimi home. The flow
# prints a link or a code to open in a browser on Windows; nothing inside the
# sandbox can reach a browser or a callback on the host.
#
# Every other provider signs in once, in the Distill app: its sessions run on
# leases of that sign-in, staged per session by `bench-auth stage`, and the
# app alone refreshes it.
set -euo pipefail
provider=${1:-}
account=${2:-}
[[ $# == 2 && $provider == kimi && $account =~ ^[A-Za-z0-9_-]{1,80}$ ]] || {
  echo "usage: bench-login kimi ACCOUNT-ID (Claude, Codex, Grok and Z.ai sign in in Distill)" >&2
  exit 64
}
home=/home/candidate/accounts/$account/kimi
install -d -o candidate -g candidate -m 700 "/home/candidate/accounts/$account" "$home"
# The CLI sees this account's home alone, never another account's sign-in.
exec /usr/local/sbin/bench-run login "login-kimi" "DISTILL_BENCH_LOGIN_HOME=$home" "KIMI_CODE_HOME=$home" \
  "TERM=${TERM:-xterm-256color}" -- kimi login
