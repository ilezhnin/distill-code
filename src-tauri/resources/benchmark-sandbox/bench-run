#!/bin/bash
# bench-run MODE ID [NAME=VALUE...] -- COMMAND [ARG...]
#
#   session ID  as candidate, /workspace = /srv/bench/work/ID, public internet only
#   check ID    as checker, /workspace = /srv/bench/checks/ID, no network
#   probe ID    as candidate, /workspace = /srv/bench/probes/ID, no network
#   login ID    as candidate, no workspace, public internet only (provider sign-in)
#
# Every mode runs in its own cgroup (memory and process caps; bench-kill ends
# it whole), in a private mount namespace that hides /mnt, the WSL sockets
# and every other attempt, with its own /tmp, a clean environment holding only
# the given variables, and no way to gain privileges.
set -euo pipefail
mode=${1:-}
id=${2:-}
if (($# < 2)); then
  echo "bench-run: usage: bench-run MODE ID [NAME=VALUE...] -- COMMAND" >&2
  exit 64
fi
shift 2
[[ $id =~ ^[A-Za-z0-9_-]{1,80}$ ]] || { echo "bench-run: bad id" >&2; exit 64; }
case $mode in
  session) user=candidate dir=/srv/bench/work/$id net=session ;;
  check) user=checker dir=/srv/bench/checks/$id net=none ;;
  probe) user=candidate dir=/srv/bench/probes/$id net=none ;;
  browser) user=checker dir=/srv/bench/checks/$id net=none ;;
  login) user=candidate dir= net=bench ;;
  *) echo "bench-run: unknown mode $mode" >&2; exit 64 ;;
esac
vars=()
resource_class=$mode
[[ $mode == session ]] && resource_class=repository
deadline=
while (($#)) && [[ $1 != -- ]]; do
  [[ $1 =~ ^[A-Z_][A-Z0-9_]*= ]] || { echo "bench-run: bad variable" >&2; exit 64; }
  if [[ $1 == DISTILL_BENCH_RESOURCE_CLASS=* ]]; then
    if [[ $mode == session && ${1#*=} =~ ^(text|repository)$ ]]; then
      resource_class=${1#*=}
    elif [[ $mode == probe && ${1#*=} == text ]]; then
      resource_class=probe
    else
      exit 64
    fi
  elif [[ $1 == DISTILL_BENCH_DEADLINE_MS=* ]]; then
    [[ ${1#*=} =~ ^[0-9]{1,16}$ ]] || exit 64
    deadline=${1#*=}
  elif [[ $1 == DISTILL_BENCH_RESERVATION=* ]]; then
    [[ ${1#*=} =~ ^[0-9a-f]{32}$ ]] || exit 64
    export DISTILL_BENCH_RESERVATION=${1#*=}
  elif [[ $1 == DISTILL_BENCH_HOST_GATE=* ]]; then
    [[ ${1#*=} =~ ^[0-9]+,[0-9]+,[0-9]+,[0-9]+,[0-9]+$ ]] || {
      echo "bench-run: the host gate needs five fields: time ms, RAM, commit, volume free, CPU busy in thousandths (1001 unknown)" >&2
      exit 64
    }
    export DISTILL_BENCH_HOST_GATE=${1#*=}
  else
    vars+=("$1")
  fi
  shift
done
[[ ${1:-} == -- ]] && shift
(($#)) || { echo "bench-run: no command" >&2; exit 64; }
[[ -z $dir || -d $dir ]] || { echo "bench-run: $dir does not exist" >&2; exit 66; }
/usr/local/sbin/bench-net
if [[ -n $deadline ]]; then export DISTILL_BENCH_DEADLINE_MS=$deadline; fi
exec /usr/local/sbin/bench-budget "$resource_class" "$id" -- \
  /usr/local/sbin/bench-run-inner "$mode" "$id" "$user" "$dir" "$net" "${vars[@]}" -- "$@"
