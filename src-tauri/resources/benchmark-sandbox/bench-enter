#!/bin/bash
# bench-enter USER DIR [NAME=VALUE...] -- COMMAND: the inner half of
# bench-run, already in the run's cgroup and network namespace and in a
# private mount namespace. Hides what the run must not see, then drops to
# USER for good.
set -euo pipefail
user=$1
dir=$2
shift 2
vars=()
account_home=
login_home=
instructions=
grok_config=
opencode_plugin=
while [[ $1 != -- ]]; do
  if [[ $1 == DISTILL_BENCH_ACCOUNT_HOME=* ]]; then
    account_home=${1#*=}
  elif [[ $1 == DISTILL_BENCH_LOGIN_HOME=* ]]; then
    login_home=${1#*=}
  elif [[ $1 == DISTILL_BENCH_INSTRUCTIONS=* ]]; then
    instructions=${1#*=}
  elif [[ $1 == DISTILL_BENCH_GROK_CONFIG=* ]]; then
    grok_config=${1#*=}
  elif [[ $1 == DISTILL_BENCH_OPENCODE_PLUGIN=* ]]; then
    opencode_plugin=${1#*=}
  else
    vars+=("$1")
  fi
  shift
done
shift
# unshare already cloned the mount namespace. Change only its existing root
# VFS mount flags; overmounting / would make current_chrooted() reject the
# nested user namespace needed by Chromium's actual sandbox. A sign-in runs
# on a read-only root as well.
mount -o remount,bind,ro /
ip link set lo up 2>/dev/null || true
mount -t tmpfs -o mode=755,size=1M,nr_inodes=256 none /mnt
for hidden in /tmp/.X11-unix /run/WSL /run/netns; do
  if [[ -d $hidden ]]; then mount -t tmpfs -o mode=755,size=1M,nr_inodes=256 none "$hidden"; fi
done
mount -t tmpfs -o mode=1777,size=256M,nr_inodes=16384 none /tmp
mount -t tmpfs -o mode=1777,size=128M,nr_inodes=8192 none /var/tmp
# Private minimal devices exclude WSL GPU, block devices and host sockets.
mount -t tmpfs -o mode=755,size=1M,nr_inodes=256 none /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts -o newinstance,ptmxmode=0666,mode=0620 none /dev/pts
ln -s pts/ptmx /dev/ptmx
for entry in 'null 1 3' 'zero 1 5' 'full 1 7' 'random 1 8' 'urandom 1 9' 'tty 5 0'; do
  read -r name major minor <<<"$entry"
  mknod -m 666 "/dev/$name" c "$major" "$minor"
done
ln -s /proc/self/fd /dev/fd
ln -s /proc/self/fd/0 /dev/stdin
ln -s /proc/self/fd/1 /dev/stdout
ln -s /proc/self/fd/2 /dev/stderr
mount -t tmpfs -o mode=1777,size=128M,nr_inodes=4096 none /dev/shm
mount -t tmpfs -o mode=755,size=1M,nr_inodes=256 none /sys
mount -t tmpfs -o mode=755,size=1M,nr_inodes=256 none /run
# A session sees the private home staged for its attempt (a lease of the
# Distill app's sign-in, or a copy of its Kimi sandbox sign-in), never shared
# CLI state or other accounts. A Kimi sign-in (no workspace) sees the one
# persistent account home it names, at its own path, and nothing else of /home.
if [[ -n $dir && -n $account_home ]]; then
  [[ $user == candidate && $account_home =~ ^/home/candidate/accounts/[A-Za-z0-9_-]{1,80}/(claude|codex|grok|kimi|zai)$ ]] || exit 64
  account_home=/srv/bench/auth/$(basename "$dir")/home
  [[ $(realpath -e "$account_home") == "$account_home" ]] || exit 64
  install -d -m 700 -o candidate -g candidate /tmp/provider
  mount --bind "$account_home" /tmp/provider
fi
if [[ -n $login_home ]]; then
  [[ -z $dir && $user == candidate && $login_home =~ ^/home/candidate/accounts/[A-Za-z0-9_-]{1,80}/kimi$ ]] || exit 64
  [[ $(realpath -e "$login_home") == "$login_home" ]] || exit 64
  install -d -m 700 /tmp/.login-home
  mount --bind "$login_home" /tmp/.login-home
fi
mount -t tmpfs -o mode=755,size=128M,nr_inodes=8192 none /home
install -d -m 700 -o "$user" -g "$user" "/home/$user"
if [[ -n $login_home ]]; then
  install -d -m 755 /home/candidate/accounts
  install -d -m 700 -o candidate -g candidate "${login_home%/*}" "$login_home"
  mount --bind /tmp/.login-home "$login_home"
  # The bind inherits the read-only root; the account home stays writable.
  mount -o remount,bind,rw "$login_home"
  umount /tmp/.login-home
  rmdir /tmp/.login-home
fi
if [[ -n $instructions ]]; then
  printf '%s\n' "$instructions" >/tmp/repository-instructions.md
fi
if [[ -n $grok_config ]]; then
  install -d -m 700 -o candidate -g candidate /home/candidate/.grok
  printf '%s\n' "$grok_config" >/home/candidate/.grok/config.toml
fi
if [[ -n $opencode_plugin ]]; then
  # OpenCode's configuration home: root-owned, so OpenCode installs no
  # packages into it and nothing a run writes becomes configuration. It holds
  # only the benchmark policy plugin that the host's configuration loads.
  install -d -m 755 -o root -g root /tmp/opencode-config /tmp/opencode-config/opencode
  printf '%s\n' "$opencode_plugin" >/tmp/opencode-config/distill-benchmark-policy.mjs
  chmod 644 /tmp/opencode-config/distill-benchmark-policy.mjs
fi
cwd=/home/$user
if [[ -n $dir ]]; then
  mount --bind "$dir" /workspace
  cwd=/workspace
fi
if [[ $user == checker && -n $dir && -d /srv/bench/submissions/$(basename "$dir") ]]; then
  mkdir -p /submission
  mount --bind "/srv/bench/submissions/$(basename "$dir")" /submission
  mount -o remount,bind,ro /submission
elif [[ -d /submission ]]; then
  mount -t tmpfs -o mode=000 none /submission
fi
if [[ $user == candidate && -n $dir && ( -e /workspace/.codex || -e /workspace/.agents ) ]]; then
  echo 'capability_missing: repository contains native Codex configuration or skills' >&2
  exit 65
fi
# Every other attempt's copy, every pristine base and every check.
mount -t tmpfs -o mode=700,size=1M,nr_inodes=256 none /srv/bench
cd "$cwd"
exec setpriv --reuid "$user" --regid "$user" --init-groups --no-new-privs \
  --inh-caps=-all --bounding-set=-all \
  env -i HOME="/home/$user" USER="$user" LOGNAME="$user" LANG=C.UTF-8 \
  PATH=/opt/distill-tools/bin:/usr/local/bin:/usr/bin:/bin "${vars[@]}" "$@"
