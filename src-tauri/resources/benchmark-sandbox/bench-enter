#!/bin/bash
# bench-enter USER DIR [NAME=VALUE...] -- COMMAND: the inner half of
# bench-run, already in the run's cgroup and network namespace and in a
# private mount namespace. Hides what the run must not see, then drops to
# USER for good.
set -euo pipefail
user=$1
dir=$2
shift 2
vars=()
account_home=
instructions=
grok_config=
while [[ $1 != -- ]]; do
  if [[ $1 == DISTILL_BENCH_ACCOUNT_HOME=* ]]; then
    account_home=${1#*=}
  elif [[ $1 == DISTILL_BENCH_INSTRUCTIONS=* ]]; then
    instructions=${1#*=}
  elif [[ $1 == DISTILL_BENCH_GROK_CONFIG=* ]]; then
    grok_config=${1#*=}
  else
    vars+=("$1")
  fi
  shift
done
shift
ip link set lo up 2>/dev/null || true
mount -t tmpfs -o mode=755 none /mnt
for hidden in /tmp/.X11-unix /run/WSL /run/netns; do
  if [[ -d $hidden ]]; then mount -t tmpfs -o mode=755 none "$hidden"; fi
done
mount -t tmpfs -o mode=1777 none /tmp
mount -t tmpfs -o mode=1777 none /dev/shm
# A session sees a private copy of its selected sandbox sign-in, never
# shared CLI state or other accounts. Login alone uses the persistent home.
if [[ -n $dir ]]; then
  if [[ -n $account_home ]]; then
    [[ $user == candidate && $account_home =~ ^/home/candidate/accounts/[A-Za-z0-9_-]{1,80}/(claude|codex|grok|kimi)$ ]] || exit 64
    account_home=/srv/bench/auth/$(basename "$dir")/home
    [[ $(realpath -e "$account_home") == "$account_home" ]] || exit 64
    install -d -m 700 -o candidate -g candidate /tmp/provider
    mount --bind "$account_home" /tmp/provider
  fi
  mount -t tmpfs -o mode=755 none /home
  install -d -m 700 -o "$user" -g "$user" "/home/$user"
fi
if [[ -n $instructions ]]; then
  printf '%s\n' "$instructions" >/tmp/repository-instructions.md
fi
if [[ -n $grok_config ]]; then
  install -d -m 700 -o candidate -g candidate /home/candidate/.grok
  printf '%s\n' "$grok_config" >/home/candidate/.grok/config.toml
fi
cwd=/home/$user
if [[ -n $dir ]]; then
  mount --bind "$dir" /workspace
  cwd=/workspace
fi
if [[ $user == candidate && -n $dir && ( -e /workspace/.codex || -e /workspace/.agents ) ]]; then
  echo 'capability_missing: repository contains native Codex configuration or skills' >&2
  exit 65
fi
# Every other attempt's copy, every pristine base and every check.
mount -t tmpfs -o mode=700 none /srv/bench
cd "$cwd"
exec setpriv --reuid "$user" --regid "$user" --init-groups --no-new-privs \
  --inh-caps=-all --bounding-set=-all \
  env -i HOME="/home/$user" USER="$user" LOGNAME="$user" LANG=C.UTF-8 \
  PATH=/opt/distill-tools/bin:/usr/local/bin:/usr/bin:/bin "${vars[@]}" "$@"
