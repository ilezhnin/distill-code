#!/bin/bash
# bench-kill MODE ID: ends every process of that run, however it forked.
set -euo pipefail
mode=${1:-}
id=${2:-}
if [[ ! $mode =~ ^(session|check|probe|login|browser|prep)$ || ! $id =~ ^[A-Za-z0-9_-]{1,80}$ ]]; then
  echo "bench-kill: bad arguments" >&2
  exit 64
fi
# A paired check owns its untrusted probe even if its supervisor was cancelled.
if [[ $mode == check ]]; then /usr/local/sbin/bench-kill probe "$id"; fi
cgroup=/sys/fs/cgroup/distill-bench/$mode-$id
# The job's own supervisor and the broker's reaper remove groups too, so the
# group can vanish at any step below: a group that is gone has stopped.
if [[ -d $cgroup ]]; then
  /usr/local/sbin/bench-budget observe "$mode" "$id"
  echo 1 2>/dev/null >"$cgroup/cgroup.kill" || [[ ! -d $cgroup ]] || {
    echo 'bench-kill: could not stop the group' >&2
    exit 70
  }
  for _ in $(seq 50); do
    [[ -z $(cat "$cgroup/cgroup.procs" 2>/dev/null) ]] && break
    sleep 0.1
  done
  [[ -z $(cat "$cgroup/cgroup.procs" 2>/dev/null) ]] || { echo 'bench-kill: processes did not stop' >&2; exit 70; }
  rmdir "$cgroup" 2>/dev/null || true
fi
