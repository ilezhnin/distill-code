#!/usr/bin/python3
"""Run a trusted check and an optional isolated probe on a private socket pair.

Only the check's exit status and output are verdict evidence. The probe has a
different UID, PID and mount namespace, no hidden files and no network. This
root supervisor never executes submitted code or parses probe responses.
"""
import json
import os
from pathlib import Path
import re
import socket
import subprocess
import sys

def main():
    if len(sys.argv) < 5 or sys.argv[3] != '--':
        return 64
    identifier, duration = sys.argv[1:3]
    if not re.fullmatch(r'[A-Za-z0-9_-]{1,80}', identifier) or not duration.isdecimal():
        return 64
    seconds = int(duration)
    if not 1 <= seconds <= 3600:
        return 64
    command = sys.argv[4:]
    metadata = Path('/srv/bench/pairs') / (identifier + '.json')
    if not metadata.exists():
        os.execv('/usr/local/sbin/bench-run', ['bench-run', 'check', identifier, '--', *command])
    if metadata.is_symlink() or metadata.stat().st_size > 65536:
        return 65
    probe_command = json.loads(metadata.read_text())['command']
    if (not isinstance(probe_command, list) or not 1 <= len(probe_command) <= 256
            or not all(isinstance(arg, str) and '\0' not in arg for arg in probe_command)
            or not probe_command[0].strip() or sum(map(len, probe_command)) > 32768):
        return 65
    subprocess.run(['/usr/local/sbin/bench-net'], check=True)
    # Cancellation of check-ID must also stop this supervisor. bench-kill
    # check kills probe-ID first, including any detached probe descendants.
    cgroup = Path('/sys/fs/cgroup/distill-bench') / ('check-' + identifier)
    cgroup.mkdir(exist_ok=True)
    (cgroup / 'memory.max').write_text(str(8 * 1024**3))
    (cgroup / 'pids.max').write_text('2048')
    (cgroup / 'cgroup.procs').write_text(str(os.getpid()))
    judge_socket, probe_socket = socket.socketpair()
    probe = judge = None
    try:
        def launch(mode, connection, argv, **kwargs):
            descriptor = connection.fileno()
            return subprocess.Popen([
                '/usr/local/sbin/bench-run', mode, identifier,
                'DISTILL_BENCH_RPC_FD=' + str(descriptor), '--', *argv,
            ], pass_fds=(descriptor,), stdin=subprocess.DEVNULL, **kwargs)
        probe = launch('probe', probe_socket, probe_command,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        judge = launch('check', judge_socket, command)
        judge_socket.close()
        probe_socket.close()
        try:
            return judge.wait(timeout=seconds)
        except subprocess.TimeoutExpired:
            print('The isolated check exceeded its time limit', file=sys.stderr)
            return 124
    finally:
        judge_socket.close()
        probe_socket.close()
        subprocess.run(['/usr/local/sbin/bench-kill', 'probe', identifier], check=True)
        if probe is not None:
            probe.wait(timeout=10)
        # The caller always kills check-ID. Do not kill our own cgroup before
        # it receives the check's exit status, including on timeout.

if __name__ == '__main__':
    raise SystemExit(main())
