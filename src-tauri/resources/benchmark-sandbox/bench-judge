#!/usr/bin/python3
"""Run a trusted check and an optional isolated probe on a private socket pair.

Only the check's exit status and output are verdict evidence. The probe has a
different UID, PID and mount namespace, no hidden files and no network. This
root supervisor never executes submitted code or parses probe responses.
"""
import base64
import json
import os
from pathlib import Path
import re
import socket
import stat
import subprocess
import sys
import threading

ARTIFACT_LIMIT = 8 * 1024 * 1024
LINK_LIMIT = 4096
LIST_ENTRY_LIMIT = 1024
LIST_NAME_BYTES_LIMIT = 256 * 1024


def artifact_listing(directory, name):
    """List bounded child names from one pinned directory, without traversing them."""
    descriptor = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                         dir_fd=directory)
    try:
        before = os.fstat(descriptor)
        names = []
        total = 0
        with os.scandir(descriptor) as entries:
            for entry in entries:
                raw = os.fsencode(entry.name)
                names.append(raw)
                total += len(raw)
                if len(names) > LIST_ENTRY_LIMIT or total > LIST_NAME_BYTES_LIMIT:
                    raise ValueError('Directory listing exceeds the limit')
        after = os.fstat(descriptor)
        identity = lambda info: (info.st_dev, info.st_ino, info.st_mode,
                                 info.st_nlink, info.st_size,
                                 info.st_mtime_ns, info.st_ctime_ns)
        if identity(before) != identity(after):
            raise ValueError('Directory changed while listing')
        return {'entries': [base64.b64encode(raw).decode('ascii') for raw in sorted(names)]}
    finally:
        os.close(descriptor)


def artifact_metadata(directory, name):
    """Inspect the final entry itself, including a link, without opening its target."""
    descriptor = os.open(name, os.O_PATH | os.O_NOFOLLOW, dir_fd=directory)
    try:
        before = os.fstat(descriptor)
        kind = ('file' if stat.S_ISREG(before.st_mode) else
                'directory' if stat.S_ISDIR(before.st_mode) else
                'symlink' if stat.S_ISLNK(before.st_mode) else 'other')
        metadata = {'kind': kind, 'mode': stat.S_IMODE(before.st_mode),
                    'size': before.st_size, 'links': before.st_nlink}
        if kind == 'symlink':
            # Linux O_PATH + an empty readlinkat path pins the link inode even
            # if the candidate concurrently renames or replaces its pathname.
            target = os.readlink(b'', dir_fd=descriptor)
            if len(target) > LINK_LIMIT:
                raise ValueError('Link target exceeds the byte limit')
            metadata['targetBase64'] = base64.b64encode(target).decode('ascii')
        after = os.fstat(descriptor)
        identity = lambda info: (info.st_dev, info.st_ino, info.st_mode,
                                 info.st_nlink, info.st_size,
                                 info.st_mtime_ns, info.st_ctime_ns)
        if identity(before) != identity(after):
            raise ValueError('Artifact changed while inspecting')
        return {'metadata': metadata}
    finally:
        os.close(descriptor)


def read_artifact(root, request):
    """Read a regular file, or inspect one entry, beneath a pinned probe directory.

    The checker alone owns this channel. Candidate RPC replies are not file
    evidence. Descriptor-relative traversal prevents renamed parents or links
    from redirecting the privileged reader to other attempts or host data.
    """
    if not isinstance(request, dict) or not (
            set(request) == {'path'} or
            set(request) == {'path', 'op'} and request['op'] in ('stat', 'list')):
        raise ValueError('Expected an artifact path')
    path = request['path']
    if not isinstance(path, str) or not 1 <= len(path) <= 4096 or '\0' in path:
        raise ValueError('Invalid artifact path')
    parts = path.split('/')
    if len(parts) > 32 or any(part in ('', '.', '..') for part in parts):
        raise ValueError('Invalid artifact path')
    directory = os.dup(root)
    try:
        for part in parts[:-1]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                            dir_fd=directory)
            os.close(directory)
            directory = child
        if request.get('op') == 'stat':
            return artifact_metadata(directory, parts[-1])
        if request.get('op') == 'list':
            return artifact_listing(directory, parts[-1])
        descriptor = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                             dir_fd=directory)
        with os.fdopen(descriptor, 'rb') as file:
            before = os.fstat(file.fileno())
            if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
                raise ValueError('Artifact is not an independent regular file')
            if before.st_size > ARTIFACT_LIMIT:
                raise ValueError('Artifact exceeds the byte limit')
            data = file.read(ARTIFACT_LIMIT + 1)
            after = os.fstat(file.fileno())
            identity = lambda info: (info.st_size, info.st_mtime_ns, info.st_ctime_ns)
            if len(data) != before.st_size or identity(before) != identity(after):
                raise ValueError('Artifact changed while reading')
            return {'data': base64.b64encode(data).decode('ascii')}
    finally:
        os.close(directory)


def serve_artifacts(connection, root):
    with connection:
        # Direct socket I/O keeps both request framing and memory bounded.
        pending = bytearray()
        try:
            while True:
                chunk = connection.recv(8193 - len(pending))
                if not chunk:
                    return
                pending.extend(chunk)
                if len(pending) > 8192:
                    return
                while b'\n' in pending:
                    raw, _, rest = pending.partition(b'\n')
                    pending = bytearray(rest)
                    try:
                        response = read_artifact(root, json.loads(raw))
                    except FileNotFoundError:
                        response = {'error': 'missing'}
                    except (ValueError, OSError, UnicodeError, RecursionError):
                        response = {'error': 'refused'}
                    connection.sendall(json.dumps(response).encode() + b'\n')
        except OSError:
            return
        finally:
            os.close(root)

def main():
    if len(sys.argv) < 5 or sys.argv[3] != '--':
        return 64
    identifier, duration = sys.argv[1:3]
    if not re.fullmatch(r'[A-Za-z0-9_-]{1,80}', identifier) or not duration.isdecimal():
        return 64
    seconds = int(duration)
    if not 1 <= seconds <= 3600:
        return 64
    command = sys.argv[4:]
    metadata = Path('/srv/bench/pairs') / (identifier + '.json')
    if not metadata.exists():
        os.execv('/usr/local/sbin/bench-run', ['bench-run', 'check', identifier, '--', *command])
    if metadata.is_symlink() or metadata.stat().st_size > 65536:
        return 65
    probe_command = json.loads(metadata.read_text())['command']
    if (not isinstance(probe_command, list) or not 1 <= len(probe_command) <= 256
            or not all(isinstance(arg, str) and '\0' not in arg for arg in probe_command)
            or not probe_command[0].strip() or sum(map(len, probe_command)) > 32768):
        return 65
    subprocess.run(['/usr/local/sbin/bench-net'], check=True)
    # Cancellation of check-ID must also stop this supervisor. bench-kill
    # check kills probe-ID first, including any detached probe descendants.
    cgroup = Path('/sys/fs/cgroup/distill-bench') / ('check-' + identifier)
    cgroup.mkdir(exist_ok=True)
    (cgroup / 'memory.max').write_text(str(8 * 1024**3))
    (cgroup / 'pids.max').write_text('2048')
    (cgroup / 'cgroup.procs').write_text(str(os.getpid()))
    judge_socket, probe_socket = socket.socketpair()
    artifact_socket, artifact_client = socket.socketpair()
    artifact_root = os.open('/srv/bench/probes/' + identifier,
                            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    artifact_reader = threading.Thread(target=serve_artifacts,
                                       args=(artifact_socket, artifact_root), daemon=True)
    artifact_reader.start()
    probe = judge = None
    try:
        def launch(mode, connection, argv, **kwargs):
            descriptor = connection.fileno()
            descriptors = [descriptor]
            variables = ['DISTILL_BENCH_RPC_FD=' + str(descriptor)]
            if mode == 'check':
                descriptors.append(artifact_client.fileno())
                variables.append('DISTILL_BENCH_ARTIFACT_FD=' + str(artifact_client.fileno()))
            return subprocess.Popen([
                '/usr/local/sbin/bench-run', mode, identifier,
                *variables, '--', *argv,
            ], pass_fds=descriptors, stdin=subprocess.DEVNULL, **kwargs)
        probe = launch('probe', probe_socket, probe_command,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        judge = launch('check', judge_socket, command)
        judge_socket.close()
        probe_socket.close()
        artifact_client.close()
        try:
            return judge.wait(timeout=seconds)
        except subprocess.TimeoutExpired:
            print('The isolated check exceeded its time limit', file=sys.stderr)
            return 124
    finally:
        judge_socket.close()
        probe_socket.close()
        artifact_client.close()
        try:
            artifact_socket.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        artifact_reader.join(timeout=2)
        subprocess.run(['/usr/local/sbin/bench-kill', 'probe', identifier], check=True)
        if probe is not None:
            probe.wait(timeout=10)
        # The caller always kills check-ID. Do not kill our own cgroup before
        # it receives the check's exit status, including on timeout.

if __name__ == '__main__':
    raise SystemExit(main())
