def set_heavy_cap(text):
    """Cap CPU-heavy jobs at once, or lift the cap. A lower cap waits for
    nothing: jobs already admitted finish, and new ones wait for it."""
    cap = heavy_cap_from(text)
    setup()
    with locked():
        if cap is None:
            HEAVY_CAP.unlink(missing_ok=True)
        else:
            HEAVY_CAP.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            staged = HEAVY_CAP.with_name(HEAVY_CAP.name + '.new')
            staged.write_text(f'{cap}\n')
            os.chmod(staged, 0o644)
            os.replace(staged, HEAVY_CAP)
    status()


# The running reaper's pid and start time (as proc_identity reads it).
# bench-net starts no process while a process with both lives.
REAPER_PID = Path('/run/distill-bench-reaper.pid')
# Consecutive failed passes (a minute) after which the reaper gives way:
# bench-net then starts a fresh one, and status shows the last error.
REAPER_FAILURES = 12
REAPER_LOG = STATE / 'reaper.err'
REAPER_LOG_LINES = 20


def note_reaper(message):
    """Append a dated line (UTC) to the bounded reaper log; never raises."""
    try:
        try:
            lines = REAPER_LOG.read_text().splitlines()[-(REAPER_LOG_LINES - 1):]
        except FileNotFoundError:
            lines = []
        stamp = datetime.datetime.fromtimestamp(time.time(), datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
        replace_private(REAPER_LOG, '\n'.join(lines + [stamp + ' ' + ' '.join(str(message).split())]) + '\n')
    except OSError:
        pass


def reaper_state():
    """'ok' while the process the pid file names is the reaper, else 'down'."""
    try:
        pid, start = REAPER_PID.read_text().split()
    except (OSError, ValueError):
        return 'down'
    return 'ok' if pid.isdigit() and proc_identity(int(pid)) == start else 'down'


def reap_pass():
    with locked():
        active = receipts()
        waiting()
        sample_cpu()
        for path in (STATE / 'outcomes').glob('*.json'):
            if path.stat().st_mtime < time.time() - 3600:
                path.unlink(missing_ok=True)
    expire_scratch({row['id'] for row in active})


REAPER_ARGV = [b'/usr/local/sbin/bench-budget', b'reap', b'--daemon']


def stop_reaper():
    """End every running reaper and wait until its lock is free. A reaper
    keeps the helpers it started with in memory and holds its lock, so after
    new helpers are installed the fresh reaper bench-net starts would exit at
    once and leave the old code reaping. Reapers are found by their command
    line, so those from before the pid file named itself stop too."""
    found = []
    for entry in Path('/proc').iterdir():
        if not entry.name.isdigit() or int(entry.name) == os.getpid():
            continue
        try:
            argv = (entry / 'cmdline').read_bytes().split(b'\0')
        except OSError:
            continue
        if argv[1:4] == REAPER_ARGV:
            found.append(int(entry.name))
    for pid in found:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    STATE.mkdir(mode=0o700, exist_ok=True)
    with open(STATE / 'reaper-lock', 'a+') as handle:
        for stubborn in (False, True):
            until = time.monotonic() + 5
            while True:
                try:
                    fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    REAPER_PID.unlink(missing_ok=True)
                    return len(found)
                except BlockingIOError:
                    if time.monotonic() >= until:
                        break
                    time.sleep(0.05)
            if stubborn:
                fail('the running benchmark reaper did not stop')
            for pid in found:
                try:
                    os.kill(pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass


def reap():
    # A detached independent owner watchdog survives Windows app termination.
    if sys.argv[2:] == ['--stop']:
        print('stopped reapers', stop_reaper())
        return 0
    setup()
    write(ROOT / 'control' / 'cgroup.procs', os.getpid())
    handle = open(STATE / 'reaper-lock', 'a+')
    if sys.argv[2:] == ['--daemon']:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        replace_private(REAPER_PID, f'{os.getpid()} {proc_identity(os.getpid())}\n')
        failures = 0
        while True:
            # One failed pass (a group still stopping, a slow cleanup) must
            # not end the watchdog; a failure that lasts a minute ends it, so
            # bench-net starts a fresh one and status names the error.
            try:
                reap_pass()
                if failures:
                    note_reaper(f'recovered after {failures} failed passes')
                failures = 0
            except Exception as error:
                failures += 1
                note_reaper(f'pass failed ({failures}/{REAPER_FAILURES}): {type(error).__name__}: {error}')
                if failures >= REAPER_FAILURES:
                    REAPER_PID.unlink(missing_ok=True)
                    return 70
            time.sleep(5)
    with locked():
        receipts()
    return 0


def own(identifier):
    ident(identifier)
    setup()
    directory = SCRATCH / 'owners'
    directory.mkdir(mode=0o700, exist_ok=True)
    if not protected(directory):
        fail('unsafe benchmark scratch owner directory')
    path = directory / (identifier + '.json')
    # A bounded independent retention deadline applies even after app crash.
    # The credential save helper retains ambiguous refresh evidence before
    # this owner can be removed; failure deliberately prevents deletion.
    replace_private(path, json.dumps({'id': identifier, 'deadline': time.time() + 7200}))


def expire_scratch(active):
    for path in (SCRATCH / 'owners').glob('*.json'):
        # One owner that cannot be read or cleaned must not keep the others.
        row = readable(path)
        try:
            identifier = ident(row['id'])
            expired = row['deadline'] < time.time()
        except (TypeError, KeyError, RuntimeError):
            continue
        if identifier not in active and expired:
            try:
                result = subprocess.run(['/usr/local/sbin/bench-clean', identifier],
                                        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                        stderr=subprocess.DEVNULL, timeout=30)
            except subprocess.TimeoutExpired:
                note_reaper(f'cleanup of {identifier} did not finish in 30 s')
                continue
            if result.returncode == 0:
                path.unlink(missing_ok=True)


def main():
    if os.geteuid() != 0:
        fail('benchmark budget broker requires root')
    if sys.argv[1:] == ['mount-scratch']:
        mount_scratch()
        return 0
    if sys.argv[1:] == ['setup']:
        setup()
        subprocess.Popen([__file__, 'reap', '--daemon'], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return 0
    if sys.argv[1:] == ['status']:
        status()
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == 'heavy-cap':
        set_heavy_cap(sys.argv[2])
        return 0
    if len(sys.argv) in (2, 3) and sys.argv[1] == 'usage':
        # What the most recent finished jobs used (newest last), for calibration.
        count = int(sys.argv[2]) if len(sys.argv) == 3 and sys.argv[2].isdigit() else 200
        try:
            for line in USAGE.read_text().splitlines()[-count:]:
                print(line)
        except OSError:
            pass
        return 0
    if len(sys.argv) in (6, 7, 8) and sys.argv[1] == 'reserve':
        if len(sys.argv) == 8 and sys.argv[7] != 'continuing':
            fail('unsupported benchmark reservation flag')
        reserve(sys.argv[2], sys.argv[3], int(sys.argv[4]), sys.argv[5], int(sys.argv[6]) if len(sys.argv) >= 7 else 0,
                len(sys.argv) == 8)
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == 'outcome':
        token = sys.argv[2]
        if not re.fullmatch('[0-9a-f]{32}', token):
            fail('invalid resource outcome token')
        print(json.dumps(outcome_receipt(token)))
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == 'check-class':
        setup()
        identifier = ident(sys.argv[2])
        print('pair' if (SCRATCH / 'pairs' / (identifier + '.json')).exists() else 'check')
        return 0
    if len(sys.argv) == 4 and sys.argv[1] == 'observe':
        observe(sys.argv[2], sys.argv[3])
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == 'release':
        release(sys.argv[2])
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == 'own':
        own(sys.argv[2])
        return 0
    if len(sys.argv) >= 4 and sys.argv[1:3] == ['control', '--']:
        setup()
        write(ROOT / 'control' / 'cgroup.procs', os.getpid())
        os.execv(sys.argv[3], sys.argv[3:])
    if sys.argv[1:2] == ['reap']:
        return reap()
    if len(sys.argv) < 5 or sys.argv[3] != '--':
        fail('invalid benchmark budget invocation')
    kind, identifier = sys.argv[1:3]
    ident(identifier)
    command = sys.argv[4:]
    if os.environ.get('DISTILL_BENCH_BUNDLE'):
        joined(kind, identifier, command)
    return run(kind, identifier, command)


def outcome_receipt(token):
    """What `bench-budget outcome TOKEN` prints: the receipt, or none."""
    path = STATE / 'outcomes' / (token + '.json')
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return {'token': token, 'infrastructureError': None}


def print_outcome():
    """The run's receipt as the last stderr line, framed by the host's nonce,
    so the host needs no second call for it."""
    if OUTCOME_TOKEN and OUTCOME_NONCE:
        try:
            print(OUTCOME_NONCE, 'outcome', json.dumps(outcome_receipt(OUTCOME_TOKEN)), file=sys.stderr, flush=True)
        except (OSError, ValueError):
            pass


if __name__ == '__main__':
    try:
        code = main()
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        if OUTCOME_TOKEN:
            try:
                reason = str(error)
                if not reason.startswith(('infrastructure_error:', 'benchmark owned execution deadline', 'benchmark host transport')):
                    reason = 'infrastructure_error: trusted sandbox resource supervision or cleanup failed'
                replace_private(STATE / 'outcomes' / (OUTCOME_TOKEN + '.json'), json.dumps({
                    'token': OUTCOME_TOKEN, 'infrastructureError': reason}))
            except OSError:
                pass
        print(str(error), file=sys.stderr)
        print_outcome()
        raise SystemExit(70)
    print_outcome()
    raise SystemExit(code)
