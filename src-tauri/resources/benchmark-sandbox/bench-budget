#!/usr/bin/python3
"""Root-owned fair admission, hierarchical limits and independent Linux leases.

The scratch filesystem is a fixed-size ext4 loop device, not a sampled du
estimate. This helper never executes a submitted file while holding root.

Admission is dynamic (policy dynamic-v2): the next job starts while what the
sandbox measures leaves room for it, not up to a fixed number of lanes.
- Memory: every admitted job claims the larger of what it uses now and what
  jobs of its class needed before (the 95th percentile of their recorded
  peaks plus a quarter; the class ceiling until eight are recorded). The
  claims and the new job's must fit the admission line, and an attempt must
  also leave room for one check and one preparation. While a check or a
  preparation waits for memory, no attempt starts; while a check waits for
  CPUs, no CPU-heavy attempt starts. Neither starves behind attempts.
- CPU: a CPU-heavy job (repository session, check, paired check, browser
  check) starts while the ceilings of the running ones and its own fit the
  physical cores the host is not using itself, an attempt leaving one
  check's two CPUs (checks that waited for CPU tighten this line), as before;
  or by measured use: a repository session while the sandbox's measured use,
  a burst allowance for each running session and the new one, the timed
  jobs' ceilings and one check's reserve fit the logical CPUs the host leaves
  free less the supervisors' (at most eight sessions, none while CPU pressure
  or check stalls exceed a tenth); a timed job while its ceiling, the other
  timed jobs' and the sessions' allowances fit them. Timed jobs carry
  cpu.weight 10000 against the sessions' 100, so they take the CPU first.
  Light jobs need the measured load below the light line.
- Scratch: the filesystem's free space must cover the new job's
  reservation, half a GiB, and the reservations of jobs admitted in the last
  two minutes; an older job's use already shows in the free space.
- Windows RAM, commit and the sandbox volume keep their floors, counting
  claims not yet in use, and the guest keeps 2 GiB free.
Every job keeps its own ceilings; admission never changes them. The
aggregate is shared by measured use, and every admission records what it
measured; every finished job records its CPU seconds and memory peak.
"""
import math
import datetime
import errno
import fcntl
import json
import os
from pathlib import Path
import re
import secrets
import select
import signal
import stat
import subprocess
import sys
import time

GIB = 1024 ** 3
MIB = 1024 ** 2
ROOT = Path('/sys/fs/cgroup/distill-bench')
STATE = Path('/run/distill-bench-budget')
SCRATCH = Path('/srv/bench')
IMAGE = Path('/var/lib/distill-bench/scratch.ext4')
HEAVY_CAP = Path('/var/lib/distill-bench/heavy-cap')
PEAKS = Path('/var/lib/distill-bench/admission-peaks.json')
DISK = 8 * GIB
INODES = 131072
OUTCOME_TOKEN = None
# The host's framing for this run's outcome receipt, printed as the last
# stderr line; taken out of the environment before anything starts, so no
# process of the run can learn it or print the line.
OUTCOME_NONCE = None
DEVICE = None
POLICY = 'dynamic-v2'
# The aggregate every admitted job shares. Admission leaves one GiB of the
# memory ceiling to trusted supervisors, page tables and filesystem
# bookkeeping; supervisors also keep their own CPU and 128 processes.
ADMISSION_MEMORY = 23 * GIB
AGGREGATE_CPU = 14
AGGREGATE_PIDS = 4096
AGGREGATE_IO = (1024 * MIB, 256 * MIB)
# An attempt leaves room for one check: its CPUs (a check's or a pair's two)
# and its memory plus one preparation's. A check or preparation refused for
# room holds new attempts back for this long, and asks again within it.
CHECK_CPUS = 2
PRIORITY_HOLD = 10
# Light jobs start while the measured load stays below this share of the
# guest's CPUs and, where Linux reports it, CPU pressure below this share.
LIGHT_LOAD = 0.75
LIGHT_PRESSURE = 0.25
# Recorded per class: peaks kept, and how many before they replace the
# ceiling. The expectation is the 95th percentile with a quarter on top.
PEAK_RING = 32
PEAK_SAMPLES = 8
# What a class claims before eight of its jobs are recorded, where that is
# less than its ceiling: a repository session waits for the remote model
# most of its time and was measured at 0.2-0.45 GiB on average, so it claims
# half its ceiling and a wave starts at full parallelism instead of two
# sessions at their 6 GiB ceilings. Its memory.max stays the ceiling, and a
# session using more than it claims claims what it uses.
INITIAL_MEMORY = {'repository': 3 * GIB}
# What the smaller claims allow, a simultaneous spike, is caught by measure:
# no new attempt starts while the jobs use more than this share of the
# admission memory or the guest's memory pressure over ten seconds exceeds
# a tenth.
MEMORY_GUARD = 0.70
MEMORY_PRESSURE = 0.10
# Checks whose share of time spent waiting for a CPU exceeds this tighten the
# CPU line by one check while the recent median stays above it.
STALL_LINE = 0.10
STALL_RING = 20
# Repository sessions spend most of their time waiting for the remote model,
# so they are admitted by what the sandbox measures rather than by their
# 2-CPU ceilings (see admit_measured): the measured use, a burst allowance
# per running session and the new one, the ceilings of the timed jobs and
# one check's reserve must fit the logical CPUs the host leaves free, less
# the supervisors' own CPU. The allowance is half a core until eight
# sessions are recorded, then their 95th percentile of average use, never
# below a quarter core nor above a session's ceiling. New sessions also wait
# while the guest's CPU pressure or the recent check stalls exceed a tenth,
# and never more than eight run at once.
SUPERVISOR_CPUS = 1
SESSION_BURST = 0.5
SESSION_BURST_FLOOR = 0.25
SESSION_PRESSURE = 0.10
REPOSITORY_SESSIONS = 8
# While a repository job ran in the last five minutes, a text attempt leaves
# room for one learned repository claim, so text sessions at their account's
# full pace cannot keep a repository run out.
REPOSITORY_ACTIVE = 300
# cgroup v2 cpu.weight by class: timed jobs (checks, pairs, browser runs)
# take the CPU first when sessions burst; preparations come next.
WEIGHTS = {'check': 10000, 'pair': 10000, 'browser': 10000, 'prep': 300}
DEFAULT_WEIGHT = 100
# What each finished job used, newest last, for calibration.
USAGE = Path('/var/lib/distill-bench/job-usage.jsonl')
USAGE_LINES = 2000
# A job's scratch reservation counts until it has run this long; after that
# its actual use shows in the filesystem's free space. Admission keeps this
# much free on top.
SCRATCH_SETTLE = 120
SCRATCH_MARGIN = 512 * MIB
# Every job's own scratch IO ceiling (read, write bytes per second).
JOB_IO = {'heavy': (128 * MIB, 32 * MIB), 'prep': (128 * MIB, 32 * MIB), 'light': (32 * MIB, 8 * MIB)}
CLASSES = {
    'text': (2 * GIB, 1, 256, 'light'),
    'repository': (6 * GIB, 2, 768, 'heavy'),
    'browser': (2 * GIB, 1, 384, 'heavy'),
    'check': (4 * GIB, 2, 512, 'heavy'),
    'pair': (8 * GIB, 2, 768, 'heavy'),
    'prep': (2 * GIB, 1, 256, 'prep'),
    'login': (2 * GIB, 1, 256, 'light'),
    'probe': (2 * GIB, 1, 256, 'light'),
}
CPU_HEAVY = ('repository', 'browser', 'check', 'pair')
ATTEMPTS = ('text', 'repository')
SENSITIVE = ('browser', 'check', 'pair')
SCRATCH_RESERVATIONS = {
    'text': (64 * 1024 ** 2, 4096), 'repository': (GIB, 16384),
    'browser': (128 * 1024 ** 2, 4096), 'check': (GIB, 16384),
    'pair': (2 * GIB, 32768), 'prep': (GIB, 32768),
    'login': (0, 0), 'probe': (128 * 1024 ** 2, 4096),
}


def fail(message):
    raise RuntimeError('capability_missing: ' + message)


def ident(value):
    if not re.fullmatch(r'[A-Za-z0-9_-]{1,80}', value):
        fail('invalid benchmark resource owner')
    return value


def write(path, value):
    path.write_text(str(value))


def ensure(path, value):
    """Write a cgroup setting only when it differs. Every broker call runs
    setup; rewriting the control group's cpu.max on each would restart its
    throttling period accounting."""
    try:
        if path.read_text().strip() == str(value):
            return
    except OSError:
        pass
    write(path, value)


def protected(path):
    info = path.lstat()
    return path.is_dir() and not path.is_symlink() and info.st_uid == 0 and not info.st_mode & 0o022


def heavy_cap_from(text):
    if not re.fullmatch(r'([1-8]|off)\n?', text):
        fail('the benchmark heavy-job cap must be 1 to 8 or off')
    value = text.strip()
    return None if value == 'off' else int(value)


def heavy_cap():
    """The operator's optional cap on CPU-heavy jobs at once; None when absent."""
    try:
        info = HEAVY_CAP.lstat()
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        fail('the benchmark heavy-job cap must be a root-owned regular file')
    return heavy_cap_from(HEAVY_CAP.read_text())


def cpu_max():
    # The control group's own CPU comes on top of the jobs' share.
    return f"{(AGGREGATE_CPU + SUPERVISOR_CPUS) * 100000} 100000"


def enable_controllers(parent):
    """Turn on the job controllers below `parent`. The kernel refuses that
    (EBUSY) while a process sits in `parent` itself, which lasts until someone
    moves it: name it, so admissions fail visibly instead of waiting as if a
    group were only busy for a moment."""
    if {'memory', 'cpu', 'pids', 'io'} <= set((parent / 'cgroup.subtree_control').read_text().split()):
        return
    try:
        write(parent / 'cgroup.subtree_control', '+memory +cpu +pids +io')
    except OSError as error:
        if error.errno != errno.EBUSY:
            raise
        fail(f'a process sits in {parent} itself, so the benchmark job controllers cannot be enabled there; '
             'move it into a child group or stop it')


def setup():
    global DEVICE
    if os.geteuid() != 0:
        fail('benchmark admission requires the trusted root broker')
    controllers = set(Path('/sys/fs/cgroup/cgroup.controllers').read_text().split())
    if not {'memory', 'cpu', 'pids', 'io'} <= controllers:
        fail('WSL cgroup v2 memory, CPU, PID and IO controllers are required')
    for parent in (Path('/sys/fs/cgroup'), ROOT):
        parent.mkdir(exist_ok=True)
        enable_controllers(parent)
    ensure(ROOT / 'memory.swap.max', 0)
    control = ROOT / 'control'
    control.mkdir(exist_ok=True)
    ensure(control / 'memory.max', 256 * 1024 ** 2)
    ensure(control / 'memory.swap.max', 0)
    ensure(control / 'pids.max', 128)
    ensure(control / 'cpu.max', f'{SUPERVISOR_CPUS * 100000} 100000')
    STATE.mkdir(mode=0o700, exist_ok=True)
    (STATE / 'attempts').mkdir(mode=0o700, exist_ok=True)
    (STATE / 'outcomes').mkdir(mode=0o700, exist_ok=True)
    for path in (STATE, STATE / 'attempts', SCRATCH):
        if not protected(path):
            fail('benchmark scratch and lease parents must be root owned')
    DEVICE = scratch_device()
    with locked():
        apply_limits()


def apply_limits():
    ensure(ROOT / 'memory.max', ADMISSION_MEMORY + GIB)
    ensure(ROOT / 'memory.high', ADMISSION_MEMORY)
    ensure(ROOT / 'cpu.max', cpu_max())
    ensure(ROOT / 'pids.max', AGGREGATE_PIDS + 128)
    if io_limit(ROOT) != tuple(map(str, AGGREGATE_IO)):
        write(ROOT / 'io.max', f"{DEVICE} rbps={AGGREGATE_IO[0]} wbps={AGGREGATE_IO[1]}")
    expected = {'memory.max': str(ADMISSION_MEMORY + GIB), 'memory.swap.max': '0',
                'cpu.max': cpu_max(), 'pids.max': str(AGGREGATE_PIDS + 128)}
    for name, value in expected.items():
        if (ROOT / name).read_text().strip() != value:
            fail('benchmark aggregate resource limit did not take effect: ' + name)
    if io_limit(ROOT) != tuple(map(str, AGGREGATE_IO)):
        fail('benchmark scratch IO limit did not take effect')


def io_limit(group):
    """The (rbps, wbps) a group's io.max sets on the scratch device."""
    for line in (group / 'io.max').read_text().splitlines():
        device, *settings = line.split()
        if device == DEVICE:
            values = dict(item.split('=', 1) for item in settings)
            return values.get('rbps'), values.get('wbps')
    return None, None


# bench-net holds this lock while it sets the sandbox up, the scratch disk's
# mount included, and marks its own children with DISTILL_BENCH_NET_LOCKED.
NET_LOCK = Path('/run/lock/distill-bench-net')
BOOT_SETUP_WAIT = 30


def scratch_mount():
    try:
        return subprocess.check_output(['findmnt', '-rn', '-M', str(SCRATCH), '-o', 'FSTYPE,SOURCE,OPTIONS'],
                                       text=True).strip().split()
    except subprocess.CalledProcessError:
        return []


def wait_for_net_setup():
    """Wait (bounded) while bench-net sets the sandbox up: right after the
    distribution boots, its boot command may still be mounting the scratch
    disk when the app's first admission arrives."""
    if os.environ.get('DISTILL_BENCH_NET_LOCKED'):
        return
    try:
        handle = open(NET_LOCK, 'r')
    except FileNotFoundError:
        return
    with handle:
        until = time.monotonic() + BOOT_SETUP_WAIT
        while time.monotonic() < until:
            try:
                fcntl.flock(handle, fcntl.LOCK_SH | fcntl.LOCK_NB)
                return
            except BlockingIOError:
                time.sleep(0.1)


def scratch_device():
    # The device must be our protected, fixed-size loop image, never the distro
    # root filesystem. A missing loop/quota implementation fails closed.
    mounts = scratch_mount()
    if not mounts:
        wait_for_net_setup()
        mounts = scratch_mount()
    if len(mounts) != 3 or mounts[0] != 'ext4' or not {'nodev', 'nosuid'} <= set(mounts[2].split(',')):
        fail('bounded benchmark scratch is not mounted (run deploy-helpers)')
    backing = subprocess.check_output(['losetup', '--noheadings', '--raw', '-O', 'BACK-FILE', mounts[1]], text=True).strip()
    if backing != str(IMAGE) or IMAGE.is_symlink() or IMAGE.stat().st_uid != 0 or IMAGE.stat().st_mode & 0o077 or IMAGE.stat().st_size != DISK:
        fail('benchmark scratch backing store differs from the fixed disk budget')
    filesystem = os.statvfs(SCRATCH)
    if filesystem.f_blocks * filesystem.f_frsize > DISK or filesystem.f_files > INODES:
        fail('benchmark scratch byte/inode limit differs from policy')
    if (filesystem.f_bfree - filesystem.f_bavail) * filesystem.f_frsize < 128 * 1024 ** 2:
        fail('benchmark scratch must retain protected root blocks for credential recovery and cleanup')
    device = SCRATCH.stat().st_dev
    return f'{os.major(device)}:{os.minor(device)}'


def mount_scratch():
    """Explicit setup only; retain the original tree as a protected backup."""
    if subprocess.run(['mountpoint', '-q', str(SCRATCH)]).returncode == 0:
        return
    # Migration cannot race an older unbudgeted helper. Refuse live benchmark
    # groups, and preserve every original byte before changing the mount.
    for group in ROOT.glob('*'):
        if group.name != 'control' and group.is_dir() and (group / 'cgroup.procs').read_text().strip():
            fail('active benchmark processes must drain before scratch migration')
    IMAGE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not IMAGE.exists():
        fd = os.open(IMAGE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'wb') as image:
            image.truncate(DISK)
        # Root-only reserved blocks retain credential evidence and cleanup
        # receipts even if an unprivileged candidate fills ordinary storage.
        subprocess.run(['mkfs.ext4', '-q', '-m', '3', '-N', str(INODES), str(IMAGE)], check=True)
    if IMAGE.is_symlink() or IMAGE.stat().st_uid != 0 or IMAGE.stat().st_mode & 0o077 or IMAGE.stat().st_size != DISK:
        fail('unsafe existing benchmark scratch image')
    SCRATCH.mkdir(mode=0o700, parents=True, exist_ok=True)
    if any(SCRATCH.iterdir()):
        backup = SCRATCH.with_name('bench-before-budget-' + str(time.time_ns()))
        SCRATCH.rename(backup)
        SCRATCH.mkdir(mode=0o700)
        print('Retained benchmark scratch backup at ' + str(backup), file=sys.stderr)
    subprocess.run(['mount', '-o', 'loop,nodev,nosuid', str(IMAGE), str(SCRATCH)], check=True)
    os.chmod(SCRATCH, 0o700)
    for name in ('work', 'base', 'checks', 'staging', 'probes', 'pairs', 'submissions', 'artifacts', 'auth', 'owners'):
        (SCRATCH / name).mkdir(mode=0o700, exist_ok=True)


def proc_identity(pid):
    try:
        # starttime disambiguates Linux PID reuse; the command name may contain spaces.
        return Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def live(receipt):
    if receipt.get('pending'):
        return receipt['pending_until'] > time.time()
    return (receipt['deadline'] > time.time() and
            proc_identity(receipt['pid']) == receipt['start'])


# How long a group's removal waits for its exiting tasks to leave.
RMDIR_RETRY = 1.0


def populated(path):
    """Whether a group still holds tasks, exiting ones included: cgroup.procs
    can read empty while they still populate it. A group that is gone holds
    nothing: bench-kill and the job's supervisor remove groups too."""
    try:
        events = dict(line.split() for line in (path / 'cgroup.events').read_text().splitlines() if line.strip())
        return events.get('populated') == '1'
    except (OSError, ValueError):
        try:
            return bool((path / 'cgroup.procs').read_text().strip())
        except FileNotFoundError:
            return False


def stop(groups, patient=True):
    """Kill and remove each group; True once every one is gone. A group whose
    tasks have not left after a short wait, exiting or stuck past the kill,
    is left for the next reap: its removal must not fail or stall another
    job's admission. Not `patient` (a group already found busy), each group
    is checked once without waiting."""
    for name in groups:
        # A group removed meanwhile has stopped.
        try:
            write(ROOT / name / 'cgroup.kill', 1)
        except FileNotFoundError:
            pass
    until = time.monotonic() + (5 if patient else 0)
    removed = True
    for name in groups:
        path = ROOT / name
        while populated(path) and time.monotonic() < until:
            time.sleep(0.05)
        if not path.exists():
            continue
        if populated(path):
            removed = False
            continue
        retry = time.monotonic() + (RMDIR_RETRY if patient else 0)
        while True:
            try:
                path.rmdir()
                break
            except FileNotFoundError:
                break
            except OSError as error:
                if error.errno != errno.EBUSY:
                    raise
                if time.monotonic() >= retry:
                    removed = False
                    break
                time.sleep(0.05)
    return removed


def locked():
    handle = open(STATE / 'lock', 'a+')
    fcntl.flock(handle, fcntl.LOCK_EX)
    return handle


def receipts():
    result = []
    for path in STATE.glob('lease-*.json'):
        value = readable(path)
        if value is None:
            continue
        if not live(value):
            # A group still busy keeps its expired lease, so a later reap
            # removes it. Once found busy it is checked without waiting: a
            # task stuck for minutes must not hold every broker call.
            if stop(value['groups'], patient='busy_since' not in value):
                path.unlink(missing_ok=True)
            elif 'busy_since' not in value:
                value['busy_since'] = time.time()
                replace_private(path, json.dumps(value))
        else:
            result.append(value)
    return result


def waiting():
    queue = []
    for path in STATE.glob('wait-*.json'):
        row = readable(path)
        if row is None:
            continue
        if live(row):
            queue.append((row['created'], path.name))
        else:
            path.unlink(missing_ok=True)
    return queue


def read_number(path, pattern=None):
    """An integer from a cgroup or proc file, None where Linux has none."""
    try:
        text = path.read_text()
    except OSError:
        return None
    if pattern is None:
        return int(text.split()[0]) if text.split() and text.split()[0].isdigit() else None
    found = re.search(pattern, text)
    return int(found.group(1)) if found else None


def leaf_memory(row):
    """What a job's leaves use now; zero before its process tree started."""
    total = 0
    for name in row['groups']:
        total += read_number(ROOT / name / 'memory.current') or 0
    return total


def peaks():
    try:
        saved = json.loads(PEAKS.read_text())
    except (OSError, ValueError):
        return {}
    return saved if isinstance(saved, dict) else {}


def expected_memory(kind, recorded):
    """What a job of `kind` is expected to need: its initial claim (the
    ceiling for most classes) until enough of its class are recorded, then
    their 95th percentile plus a quarter."""
    ceiling = CLASSES[kind][0]
    seen = sorted(value for value in recorded.get(kind, []) if isinstance(value, int) and value > 0)
    if len(seen) < PEAK_SAMPLES:
        return min(ceiling, INITIAL_MEMORY.get(kind, ceiling))
    p95 = seen[min(len(seen) - 1, math.ceil(0.95 * len(seen)) - 1)]
    return min(ceiling, max(256 * MIB, p95 + p95 // 4))


def claim(row, recorded):
    return max(leaf_memory(row), expected_memory(row['kind'], recorded)) + row.get('host_buffers', 0)


def replace_private(path, text):
    """Write a root-only state file whole, never half. The staging name is
    the writer's own, so two writers of one file never mix their bytes."""
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    staged = path.with_name(f'{path.name}.{os.getpid()}.new')
    staged.write_text(text)
    os.chmod(staged, 0o600)
    os.replace(staged, path)


# A state file that does not parse and is older than this was left half
# written by a crash (every writer replaces files whole); it is set aside.
TORN_AFTER = 60


def readable(path):
    """The JSON state in `path`, or None when it is gone or does not parse.
    One that does not parse and is older than TORN_AFTER is renamed
    `.unreadable` and noted in the reaper log, so it stops failing every pass
    while staying there for the operator."""
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return None
    except ValueError:
        try:
            if path.stat().st_mtime < time.time() - TORN_AFTER:
                path.rename(path.with_name(path.name + '.unreadable'))
                note_reaper(f'set aside unreadable {path.name}')
        except OSError:
            pass
        return None


def record_peak(kind, groups):
    """Keep the peak memory of a finished job for its class's expectation."""
    peak = sum(read_number(ROOT / name / 'memory.peak') or 0 for name in groups)
    if peak <= 0:
        return
    recorded = peaks()
    ring = [value for value in recorded.get(kind, []) if isinstance(value, int)][-(PEAK_RING - 1):]
    recorded[kind] = ring + [peak]
    replace_private(PEAKS, json.dumps(recorded))


def record_usage(kind, identifier, groups, admitted_at):
    """Keep what a finished job used: CPU seconds, average cores over its
    run, memory peak and wall time. The class's average cores teach the
    repository sessions' burst allowance (session_burst)."""
    wall = time.time() - admitted_at
    usage = [read_number(ROOT / name / 'cpu.stat', r'usage_usec (\d+)') for name in groups]
    if wall <= 0 or not usage or any(value is None for value in usage):
        return
    seconds = sum(usage) / 1e6
    cores = round(seconds / wall, 4)
    recorded = peaks()
    key = 'cpu-' + kind
    ring = [value for value in recorded.get(key, []) if isinstance(value, (int, float))][-(PEAK_RING - 1):]
    recorded[key] = ring + [cores]
    replace_private(PEAKS, json.dumps(recorded))
    entry = json.dumps({'at': round(time.time(), 1), 'kind': kind, 'id': identifier, 'wallSeconds': round(wall, 1),
                        'cpuSeconds': round(seconds, 2), 'cores': cores,
                        'memoryPeak': sum(read_number(ROOT / name / 'memory.peak') or 0 for name in groups)})
    try:
        kept = USAGE.read_text().splitlines()[-(USAGE_LINES - 1):]
    except OSError:
        kept = []
    replace_private(USAGE, '\n'.join(kept + [entry]) + '\n')


def session_burst(recorded):
    """The CPUs a new repository session is expected to add at once (see
    SESSION_BURST)."""
    seen = sorted(value for value in recorded.get('cpu-repository', [])
                  if isinstance(value, (int, float)) and value >= 0)
    if len(seen) < PEAK_SAMPLES:
        return SESSION_BURST
    p95 = seen[min(len(seen) - 1, math.ceil(0.95 * len(seen)) - 1)]
    return min(float(CLASSES['repository'][1]), max(SESSION_BURST_FLOOR, p95))


def learned(kind, recorded):
    return sum(isinstance(value, int) and value > 0 for value in recorded.get(kind, [])) >= PEAK_SAMPLES


def stall_total(groups):
    """Microseconds a job's leaves had runnable tasks waiting for a CPU."""
    totals = [read_number(ROOT / name / 'cpu.pressure', r'some [^\n]*total=(\d+)') for name in groups]
    return None if any(value is None for value in totals) else sum(totals)


def record_stall(kind, groups, started, before):
    """Keep a finished check's share of time spent waiting for a CPU."""
    after = stall_total(groups)
    elapsed = time.time() - started
    if kind not in SENSITIVE or before is None or after is None or elapsed < 1:
        return
    path = STATE / 'stalls.json'
    try:
        ring = json.loads(path.read_text())
    except (OSError, ValueError):
        ring = []
    ring = [value for value in ring if isinstance(value, (int, float))][-(STALL_RING - 1):]
    ring.append(round(max(0, after - before) / 1e6 / elapsed, 4))
    path.write_text(json.dumps(ring))


def recent_stall():
    try:
        ring = [value for value in json.loads((STATE / 'stalls.json').read_text()) if isinstance(value, (int, float))]
    except (OSError, ValueError):
        return None
    recent = sorted(ring[-10:])
    return recent[len(recent) // 2] if recent else None


def cpu_samples():
    try:
        ring = json.loads((STATE / 'cpu.json').read_text())
    except (OSError, ValueError):
        return []
    now = time.time()
    return [sample for sample in ring if isinstance(sample, list) and len(sample) == 2
            and isinstance(sample[0], (int, float)) and isinstance(sample[1], int) and now - 60 < sample[0] <= now + 1]


def sample_cpu():
    """Keep the aggregate's CPU use: at every admission decision and, from
    the reaper, every few seconds; at most one sample a second."""
    usage = read_number(ROOT / 'cpu.stat', r'usage_usec (\d+)')
    if usage is None:
        return
    ring = cpu_samples()
    now = time.time()
    if not ring or now - ring[-1][0] >= 1:
        ring = (ring + [[now, usage]])[-16:]
        (STATE / 'cpu.json').write_text(json.dumps(ring))


def sandbox_cores():
    """CPUs the benchmark jobs used over the last few sampled seconds, None
    without a recent sample and one at least three seconds older."""
    ring = cpu_samples()
    if not ring or time.time() - ring[-1][0] > 20:
        return None
    at, used = ring[-1]
    older = [sample for sample in ring if at - sample[0] >= 3]
    if not older or used < older[-1][1]:
        return None
    before, used_before = older[-1]
    return (used - used_before) / 1e6 / (at - before)


def job_pressure():
    """The highest share of time, over ten seconds, that any running job's
    tasks waited for a CPU: the jobs' own cgroups, never the supervisors'
    control group (whose half-core ceiling throttles its own bursts of
    status and cleanup work). None without a job."""
    worst = None
    try:
        leaves = [path for path in ROOT.iterdir() if path.is_dir() and path.name != 'control']
    except OSError:
        return None
    for leaf in leaves:
        try:
            text = (leaf / 'cpu.pressure').read_text()
        except OSError:
            continue
        match = re.search(r'some avg10=([0-9.]+)', text)
        if match:
            value = float(match.group(1)) / 100
            worst = value if worst is None else max(worst, value)
    return worst


def guest_pressure(resource='cpu'):
    """The guest's share of time with tasks stalled on `resource` (cpu or
    memory), over ten seconds."""
    try:
        found = re.search(r'some avg10=([0-9.]+)', Path('/proc/pressure/' + resource).read_text())
    except OSError:
        return None
    return float(found.group(1)) / 100 if found else None


def cpu_capacity(host_cores, measured):
    """Logical CPUs the host leaves the benchmark jobs, less the supervisors'
    own: the line repository sessions are admitted against by measured use."""
    cpus = os.cpu_count() or 2
    outside = 0.0 if host_cores is None else max(0.0, host_cores - (measured or 0.0))
    return cpus - math.ceil(outside) - SUPERVISOR_CPUS


def cpu_line(host_cores, measured):
    """Physical cores the host leaves the CPU-heavy jobs counted by their
    ceilings: the guest's CPUs as cores (two threads each) less what the host
    itself runs outside the sandbox, less one check while checks have been
    waiting for CPU. Whatever this admits, admission never refuses."""
    cpus = os.cpu_count() or 2
    physical = max(CHECK_CPUS, cpus // 2)
    outside = 0.0 if host_cores is None else max(0.0, host_cores - (measured or 0.0))
    stalled = recent_stall()
    tightening = CHECK_CPUS if stalled is not None and stalled > STALL_LINE else 0
    return max(CHECK_CPUS, physical - math.ceil(outside) - tightening)


def repository_active(active):
    """Whether a repository job runs or was admitted or refused in the last
    REPOSITORY_ACTIVE seconds."""
    if any(row['kind'] == 'repository' for row in active):
        return True
    try:
        held = json.loads((STATE / 'priority.json').read_text())
    except (OSError, ValueError):
        return False
    return isinstance(held, dict) and held.get('repository-active', 0) > time.time()


def priority_waiting(kind):
    """Who holds an attempt of `kind` back, if anyone (None): a check or
    preparation refused, moments ago, the room it would take (memory holds
    every attempt, CPUs only the CPU-heavy ones), or, for a text attempt, a
    repository attempt refused the memory text sessions claim (see decide)."""
    try:
        held = json.loads((STATE / 'priority.json').read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(held, dict):
        return None
    now = time.time()
    if held.get('memory', 0) > now or (kind in CPU_HEAVY and held.get('cpu', 0) > now):
        return 'a check or preparation waits for room first'
    if kind == 'text' and held.get('repository', 0) > now:
        return 'a repository attempt waits for the memory text sessions claim'
    return None


def hold(resource, until=None):
    """Hold attempts back for `resource` until `until` (None: release it)."""
    path = STATE / 'priority.json'
    try:
        held = json.loads(path.read_text())
    except (OSError, ValueError):
        held = {}
    held = held if isinstance(held, dict) else {}
    if until is None:
        if resource not in held:
            return
        held.pop(resource)
    else:
        held[resource] = until
    path.write_text(json.dumps(held))


def decide(active, kind, gate, host_buffers=0, continuing=False):
    """Admit `kind` beside `active` or raise BlockingIOError naming the line
    that holds it. Returns the measurements it decided on. A check or
    preparation it refuses holds new attempts back (see PRIORITY_HOLD)."""
    try:
        observed = admit_measured(active, kind, gate, host_buffers, continuing)
    except BlockingIOError as busy:
        reason = str(busy)
        # A check the operator's cap refuses also holds sessions back, so it
        # takes the next freed place instead of a new session; so does a
        # later workflow step, whose earlier steps are paid for.
        if (kind not in ATTEMPTS or continuing) and 'Windows headroom evidence expired' not in reason:
            hold('cpu' if 'CPU' in reason else 'memory', time.time() + PRIORITY_HOLD)
        elif getattr(busy, 'text_would_free', False):
            # Text sessions need less room and refill every few minutes, so
            # a repository attempt's larger claim would never fit beside them.
            hold('repository', time.time() + PRIORITY_HOLD)
        raise
    finally:
        if kind == 'repository':
            hold('repository-active', time.time() + REPOSITORY_ACTIVE)
    if kind == 'repository':
        hold('repository')
    return observed


def admit_measured(active, kind, gate, host_buffers, continuing=False):
    """Admission of `kind`. A `continuing` session (a later step of a
    workflow already under way) is an attempt that goes ahead of new ones:
    no priority hold, no CPU pressure or check-stall guard, no session cap,
    no room kept for another repository claim; its ceilings, the memory
    claims and guard, the CPU lines and the Windows floors still apply."""
    memory, cpu, pids, lane = CLASSES[kind]
    held = priority_waiting(kind) if kind in ATTEMPTS and not continuing else None
    if held:
        raise BlockingIOError('resource_busy: ' + held + '; no provider process started')
    if kind in ATTEMPTS:
        in_use = read_number(ROOT / 'memory.current') or 0
        stalled_memory = guest_pressure('memory')
        if in_use > MEMORY_GUARD * ADMISSION_MEMORY or (stalled_memory is not None and stalled_memory > MEMORY_PRESSURE):
            raise BlockingIOError('resource_busy: sandbox memory in use or memory pressure is above its guard line; no provider process started')
    sample_cpu()
    recorded = peaks()
    claims = sum(claim(row, recorded) for row in active)
    unused = sum(max(0, claim(row, recorded) - leaf_memory(row)) for row in active)
    needed = expected_memory(kind, recorded) + host_buffers
    if kind in ATTEMPTS:
        needed_room = needed + expected_memory('check', recorded) + expected_memory('prep', recorded)
    else:
        needed_room = needed
    if kind == 'text' and not continuing and learned('repository', recorded) and repository_active(active):
        needed_room += expected_memory('repository', recorded)
    if claims + needed_room > ADMISSION_MEMORY:
        busy = BlockingIOError('resource_busy: sandbox memory the running jobs claim leaves no room for this job; no provider process started')
        # Whether the text sessions' leaving would make the room a refused
        # repository attempt lacks (decide then holds new ones back).
        lacking = claims + needed_room - ADMISSION_MEMORY
        busy.text_would_free = kind == 'repository' and sum(
            claim(row, recorded) for row in active if row['kind'] == 'text') >= lacking
        raise busy
    if (read_number(ROOT / 'pids.current') or 0) + pids > AGGREGATE_PIDS:
        raise BlockingIOError('resource_busy: sandbox process budget leaves no room for this job; no provider process started')
    observed = host_gate(gate, unused, needed)
    measured = sandbox_cores()
    host_cores = observed.get('hostCpuBusy')
    host_cores = None if host_cores is None else host_cores * (os.cpu_count() or 1)
    line = cpu_line(host_cores, measured)
    capacity = cpu_capacity(host_cores, measured)
    heavy = [row for row in active if row['kind'] in CPU_HEAVY]
    ceilings = sum(row['cpu'] for row in heavy)
    timed = sum(row['cpu'] for row in active if row['kind'] in SENSITIVE)
    sessions = sum(row['kind'] == 'repository' for row in active)
    burst = session_burst(recorded)
    pressure = job_pressure()
    stalled = recent_stall()
    admitted_by = None
    if kind in CPU_HEAVY:
        cap = heavy_cap()
        if cap is not None and len(heavy) >= cap:
            raise BlockingIOError('resource_busy: the operator caps CPU-heavy benchmark jobs at ' + str(cap) + '; no provider process started')
        reserve = CHECK_CPUS if kind in ATTEMPTS else 0
        if ceilings + cpu + reserve <= line:
            admitted_by = 'ceilings'
        elif kind == 'repository':
            if sessions >= REPOSITORY_SESSIONS and not continuing:
                raise BlockingIOError('resource_busy: the sandbox runs its most repository sessions at once; no provider process started')
            if not continuing and ((pressure is not None and pressure > SESSION_PRESSURE)
                                   or (stalled is not None and stalled > STALL_LINE)):
                raise BlockingIOError('resource_busy: CPU pressure in the sandbox holds new repository sessions; no provider process started')
            used = measured if measured is not None else ceilings
            if used + burst * (sessions + 1) + timed + CHECK_CPUS <= capacity:
                admitted_by = 'measured'
        elif timed + cpu + burst * sessions <= capacity:
            admitted_by = 'measured'
        if admitted_by is None:
            raise BlockingIOError('resource_busy: CPU cores the host leaves free cannot cover this job beside the running checks and sessions; no provider process started')
    else:
        busy = (measured if measured is not None else ceilings) + (0.0 if host_cores is None else max(0.0, host_cores - (measured or 0.0)))
        if busy + cpu > LIGHT_LOAD * (os.cpu_count() or 1) or (
                not continuing and pressure is not None and pressure > LIGHT_PRESSURE):
            raise BlockingIOError('resource_busy: measured CPU load is above the light-job admission line; no provider process started')
    observed.update(expectedMemory=needed, claimedMemory=claims, cpuLine=line, heavyCpus=ceilings,
                    sandboxCpu=None if measured is None else round(measured, 3),
                    cpuPressure=pressure, checkStall=stalled, cpuCapacity=capacity,
                    sessionBurst=round(burst, 3), repositorySessions=sessions, admittedBy=admitted_by)
    if continuing:
        observed['continuing'] = True
    return observed


def admission(active, kind, observed):
    """The policy and the competing load this job was admitted under."""
    competing = {}
    for row in active:
        key = row.get('kind', row['lane'])
        competing[key] = competing.get(key, 0) + 1
    return dict(policy=POLICY, heavyCap=heavy_cap(), lane=CLASSES[kind][3],
                competing=competing,
                competingHeavy=sum(row['kind'] in CPU_HEAVY for row in active),
                reservedMemory=observed.pop('claimedMemory'),
                reservedCpu=observed.pop('heavyCpus'),
                memoryCurrent=int((ROOT / 'memory.current').read_text()),
                guestLoad=[round(value, 2) for value in os.getloadavg()],
                guestCpus=os.cpu_count(), **observed)


# How far the Windows evidence's time may be from the sandbox clock. WSL2's
# clock can fall behind Windows after sleep or hibernation until it is
# resynchronised; a minute-old RAM figure is harmless beside the 12 GiB and
# 8 GiB floors, while a refusal would stop every admission until then.
GATE_SKEW_MS = 60_000


def gate_age(gate):
    """How old the Windows evidence is by the sandbox clock, in ms, or None."""
    try:
        return round(time.time() * 1000 - int(gate.split(',')[0]))
    except (ValueError, AttributeError):
        return None


def host_gate(gate, unused, memory):
    """Check the Windows floors and the guest's against this job's need and
    the claims of earlier jobs not yet in use. The host's evidence names its
    available RAM, commit headroom, sandbox volume free space and, as a
    share of its CPUs in thousandths, how busy it is."""
    try:
        timestamp, available_ram, commit, disk, busy = map(int, gate.split(','))
    except (ValueError, AttributeError):
        fail('fresh Windows headroom evidence is required before benchmark admission')
    age = time.time() * 1000 - timestamp
    if not -GATE_SKEW_MS <= age <= GATE_SKEW_MS:
        raise BlockingIOError(
            f'resource_busy: Windows headroom evidence expired before execution: its time is {age / 1000:+.1f} s '
            'from the sandbox clock, beyond 60 s either way (resynchronise the WSL clock if this lasts); '
            'no provider process started')
    additional = memory + unused
    if available_ram < 12 * GIB + additional:
        raise BlockingIOError('resource_busy: Windows available RAM cannot cover benchmark reservations and its 12 GiB desktop floor; no provider process started')
    if commit < 8 * GIB + additional:
        raise BlockingIOError('resource_busy: Windows commit headroom cannot cover benchmark reservations and its 8 GiB floor; no provider process started')
    if disk < 30 * GIB:
        raise BlockingIOError('resource_busy: the registered sandbox volume has less than 30 GiB free; no provider process started')
    # Other WSL distributions share the guest VM. Parent caps alone do not
    # protect an Ubuntu workload already occupying most guest memory.
    guest = {line.split(':', 1)[0]: int(line.split()[1]) * 1024
             for line in Path('/proc/meminfo').read_text().splitlines() if line.startswith('MemAvailable:')}
    if guest.get('MemAvailable', 0) < 2 * GIB + additional:
        raise BlockingIOError('resource_busy: shared WSL memory cannot cover benchmark reservations and its 2 GiB floor; no provider process started')
    return dict(hostAvailableRam=available_ram, hostAvailableCommit=commit,
                guestMemAvailable=guest['MemAvailable'],
                hostCpuBusy=None if not 0 <= busy <= 1000 else busy / 1000,
                hostGateAgeMs=round(age))


def scratch_headroom(active, kind):
    filesystem = os.statvfs(SCRATCH)
    needed_bytes, needed_inodes = SCRATCH_RESERVATIONS[kind]
    # Jobs admitted in the last moments may not have written yet; older ones
    # already show in the free space (rows without an admission time count).
    young = [row for row in active if time.time() - row.get('admitted', 0) < SCRATCH_SETTLE]
    needed_bytes += SCRATCH_MARGIN + sum(row.get('scratch_bytes', 0) for row in young)
    needed_inodes += 4096 + sum(row.get('scratch_inodes', 0) for row in young)
    if filesystem.f_bavail * filesystem.f_frsize < needed_bytes or filesystem.f_favail < needed_inodes:
        raise BlockingIOError('resource_busy: bounded benchmark scratch has insufficient free bytes/inodes for committed phases; no provider process started')


def scratch_runtime_floor():
    filesystem = os.statvfs(SCRATCH)
    if filesystem.f_bavail * filesystem.f_frsize < 64 * 1024 ** 2 or filesystem.f_favail < 4096:
        raise RuntimeError('infrastructure_error: bounded benchmark scratch resource floor reached during execution')


def make_groups(kind, identifier):
    memory, cpu, pids, lane = CLASSES[kind]
    read, written = JOB_IO[lane]
    prefix = 'check-' if kind == 'pair' else 'session-' if kind in ('text', 'repository') else kind + '-'
    groups = [prefix + identifier]
    if kind == 'pair':
        groups.append('probe-' + identifier)
    made = []
    try:
        for name in groups:
            # A pair's two leaves split its envelope, like its memory and CPUs.
            share = len(groups)
            child_group(name, memory // share, cpu // share, pids // share, read // share, written // share,
                        WEIGHTS.get(kind, DEFAULT_WEIGHT))
            made.append(name)
    except BaseException:
        stop(made)
        raise
    return groups


def reserve(kind, identifier, deadline_ms, gate, host_buffers=0, continuing=False):
    deadline = deadline_ms / 1000
    ident(identifier)
    if kind not in CLASSES or not time.time() < deadline <= time.time() + 86400 + 480 or not 0 <= host_buffers <= GIB + 65536:
        fail('unsupported benchmark class or reservation deadline')
    setup()
    with locked():
        active = receipts()
        # Sign-ins and probes queue without a reservation; attempts wait
        # behind them, checks and preparations go ahead.
        if kind in ATTEMPTS and not continuing and waiting():
            raise BlockingIOError('resource_busy: benchmark resource capacity is queued; no provider process started')
        observed = decide(active, kind, gate, host_buffers, continuing)
        scratch_headroom(active, kind)
        record = admission(active, kind, observed)
        groups = make_groups(kind, identifier)
        token = secrets.token_hex(16)
        memory, cpu, pids, lane = CLASSES[kind]
        scratch_bytes, scratch_inodes = SCRATCH_RESERVATIONS[kind]
        row = dict(pending=True, pending_until=time.time() + 60, kind=kind, id=identifier,
                   groups=groups, deadline=deadline, memory=memory + host_buffers, cpu=cpu, pids=pids, lane=lane,
                   host_buffers=host_buffers, admitted=time.time())
        row.update(scratch_bytes=scratch_bytes, scratch_inodes=scratch_inodes)
        replace_private(STATE / ('lease-' + token + '.json'), json.dumps(row))
        print(json.dumps({'token': token, 'id': identifier, 'class': kind, 'deadlineMs': deadline_ms,
                          'admission': record}))


def release(token):
    if not re.fullmatch('[0-9a-f]{32}', token):
        fail('invalid benchmark reservation token')
    with locked():
        path = STATE / ('lease-' + token + '.json')
        if path.exists():
            row = json.loads(path.read_text())
            if row.get('pending') and stop(row['groups']):
                path.unlink()


def observe(mode, identifier):
    ident(identifier)
    if mode not in ('session', 'check', 'probe', 'login', 'browser', 'prep'):
        fail('invalid sandbox observation mode')
    name = mode + '-' + identifier
    events = ROOT / name / 'memory.events'
    # The job's supervisor and the reaper remove groups: one that is gone,
    # before or while it is read, has nothing left to observe.
    try:
        counters = dict(line.split() for line in events.read_text().splitlines())
    except FileNotFoundError:
        return
    if not int(counters.get('oom_kill', 0)):
        return
    with locked():
        for path in STATE.glob('lease-*.json'):
            row = readable(path)
            if row is not None and name in row['groups']:
                token = path.name[6:-5]
                replace_private(STATE / 'outcomes' / (token + '.json'), json.dumps({
                    'token': token, 'infrastructureError': 'infrastructure_error: benchmark process tree reached its memory ceiling'}))


def child_group(name, memory, cpu, pids, read, written, weight):
    if DEVICE is None:
        fail('benchmark scratch device is unknown')
    path = ROOT / name
    path.mkdir()
    try:
        for key, value in {'memory.max': memory, 'memory.swap.max': 0, 'pids.max': pids,
                           'cpu.max': f'{cpu * 100000} 100000', 'cpu.weight': weight}.items():
            write(path / key, value)
            if (path / key).read_text().strip() != str(value):
                fail('benchmark child resource limit did not take effect')
        write(path / 'io.max', f'{DEVICE} rbps={read} wbps={written}')
        if io_limit(path) != (str(read), str(written)):
            fail('benchmark child IO limit did not take effect')
        write(path / 'memory.oom.group', 1)
    except BaseException:
        path.rmdir()
        raise


def joined(mode, identifier, command):
    token = os.environ.get('DISTILL_BENCH_BUNDLE', '')
    lease = STATE / ('lease-' + token + '.json')
    if not re.fullmatch('[0-9a-f]{32}', token) or not lease.is_file():
        fail('missing owned resource bundle')
    row = json.loads(lease.read_text())
    if row['id'] != identifier or not live(row):
        fail('resource bundle owner expired')
    group = row['groups'][1 if mode == 'probe' and len(row['groups']) == 2 else 0]
    write(ROOT / group / 'cgroup.procs', os.getpid())
    os.execv(command[0], command)


def run(kind, identifier, command):
    global OUTCOME_TOKEN
    if kind not in CLASSES:
        fail('unsupported benchmark resource class')
    setup()
    write(ROOT / 'control' / 'cgroup.procs', os.getpid())
    reserved = os.environ.pop('DISTILL_BENCH_RESERVATION', None)
    global OUTCOME_NONCE
    nonce = os.environ.pop('DISTILL_BENCH_OUTCOME_NONCE', None)
    if nonce and re.fullmatch('[0-9a-f]{32}', nonce):
        OUTCOME_NONCE = nonce
    token = reserved or secrets.token_hex(16)
    if not re.fullmatch('[0-9a-f]{32}', token):
        fail('invalid benchmark resource reservation')
    ticket = STATE / ('wait-' + token + '.json')
    started = time.time()
    host_buffers = int(os.environ.pop('DISTILL_BENCH_HOST_BUFFER_BYTES', '0'))
    if not 0 <= host_buffers <= 1024 ** 3 + 65536:
        fail('invalid benchmark host transport reservation')
    deadline_ms = os.environ.pop('DISTILL_BENCH_DEADLINE_MS', None)
    deadline = min(started + 86400 + 480, int(deadline_ms) / 1000) if deadline_ms else started + (120 if kind == 'prep' else 3600)
    if deadline <= started:
        raise TimeoutError('benchmark deadline expired before resource admission')
    replace_private(ticket, json.dumps({'pid': os.getpid(), 'start': proc_identity(os.getpid()),
                                        'deadline': min(deadline, started + 300), 'created': time.time_ns()}))
    lease = STATE / ('lease-' + token + '.json')
    groups = []
    owned = False
    child = None
    def cancelled(_signal, _frame):
        raise TimeoutError('benchmark resource owner cancelled')
    signal.signal(signal.SIGTERM, cancelled)
    signal.signal(signal.SIGHUP, cancelled)
    signal.signal(signal.SIGINT, cancelled)
    try:
        announced = False
        if reserved:
            with locked():
                if not lease.is_file():
                    raise BlockingIOError('resource_busy: pending benchmark reservation expired before execution; no provider process started')
                row = json.loads(lease.read_text())
                if not row.get('pending') or not live(row) or row['id'] != identifier or row['kind'] != kind:
                    fail('benchmark resource reservation differs from execution owner/class')
                # Claiming is not a second admission. The complete reservation
                # already accounts for pending launchers without a race.
                groups, deadline = row['groups'], row['deadline']
                row.update(pending=False, pid=os.getpid(), start=proc_identity(os.getpid()))
                replace_private(lease, json.dumps(row))
                owned = True
                OUTCOME_TOKEN = token
                ticket.unlink(missing_ok=True)
        while not reserved:
            if time.time() >= min(deadline, started + 300):
                raise TimeoutError('resource_busy: benchmark resource queue expired before execution')
            with locked():
                active = receipts()
                queue = waiting()
                admitted = False
                if queue and min(queue)[1] == ticket.name:
                    try:
                        decide(active, kind, os.environ.get('DISTILL_BENCH_HOST_GATE'), host_buffers)
                        admitted = True
                    except BlockingIOError as busy:
                        # Room may still open in the queue; stale Windows
                        # evidence cannot, so the host asks again with new.
                        if 'Windows headroom evidence expired' in str(busy):
                            raise
                if admitted:
                    scratch_headroom(active, kind)
                    memory, cpu, pids, lane = CLASSES[kind]
                    groups = make_groups(kind, identifier)
                    row = dict(pid=os.getpid(), start=proc_identity(os.getpid()), deadline=deadline, kind=kind,
                               id=identifier, groups=groups, memory=memory + host_buffers, cpu=cpu, pids=pids, lane=lane,
                               host_buffers=host_buffers, admitted=time.time())
                    scratch_bytes, scratch_inodes = SCRATCH_RESERVATIONS[kind]
                    row.update(scratch_bytes=scratch_bytes, scratch_inodes=scratch_inodes)
                    replace_private(lease, json.dumps(row))
                    owned = True
                    OUTCOME_TOKEN = token
                    ticket.unlink(missing_ok=True)
                    break
            if not announced:
                print('resource_waiting: benchmark queued for ' + kind + ' capacity', file=sys.stderr, flush=True)
                announced = True
            time.sleep(0.2)
        print('resource_admitted: ' + kind, file=sys.stderr, flush=True)
        admitted_at = time.time()
        stalled_before = stall_total(groups)
        owner_path = SCRATCH / 'owners' / (identifier + '.json')
        if owner_path.exists():
            replace_private(owner_path, json.dumps({'id': identifier, 'deadline': max(deadline + 300, time.time() + 7200)}))
        env = dict(os.environ, DISTILL_BENCH_BUNDLE=token)
        # Supervisors stay in the reserved control group; only actual workers
        # enter leaves. A paired supervisor must survive killing either child.
        def enter():
            if kind != 'pair':
                write(ROOT / groups[0] / 'cgroup.procs', os.getpid())
        child = subprocess.Popen(command, env=env, preexec_fn=enter)
        disconnect = select.poll()
        if kind in ('text', 'repository'):
            # Observe HUP without reading a byte from the ACP stream. This
            # lets Windows crash/disconnect end an ignoring or detached CLI;
            # inherited stdin is still consumed exclusively by the child.
            disconnect.register(0, select.POLLHUP | select.POLLERR)
            disconnect.register(1, select.POLLHUP | select.POLLERR)
        while True:
            scratch_runtime_floor()
            remaining = deadline - time.time()
            if remaining <= 0:
                raise TimeoutError('benchmark owned execution deadline expired')
            try:
                code = child.wait(timeout=min(1, remaining))
                scratch_runtime_floor()
                for name in groups:
                    events = ROOT / name / 'memory.events'
                    if events.exists():
                        counters = dict(line.split() for line in events.read_text().splitlines())
                        if int(counters.get('oom_kill', 0)):
                            raise RuntimeError('infrastructure_error: benchmark process tree reached its memory ceiling')
                return code
            except subprocess.TimeoutExpired:
                if disconnect.poll(0):
                    raise TimeoutError('benchmark host transport disconnected')
    finally:
        ticket.unlink(missing_ok=True)
        if owned:
            with locked():
                # What this job needed and how long it waited for CPUs teach
                # admission before its leaves go.
                try:
                    if groups and 'admitted_at' in locals():
                        record_peak(kind, groups)
                        record_usage(kind, identifier, groups, admitted_at)
                        record_stall(kind, groups, admitted_at, stalled_before)
                except (OSError, ValueError):
                    pass
                # A group still busy keeps the lease for the next reap; this
                # supervisor is gone by then, so the lease is not live.
                if stop(groups):
                    lease.unlink(missing_ok=True)
        if child is not None:
            try:
                child.wait(timeout=5)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()


