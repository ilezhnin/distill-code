#!/bin/bash
# bench-patch ID > answer.patch
# Everything the candidate changed in its copy, new files included, as a
# binary patch against the pristine base. The candidate's own .git is never
# read, and no hook, filter or monitor of its configuration runs; the base's
# index is reset afterwards, so the call can repeat.
set -euo pipefail
[[ $EUID == 0 ]] || { echo "bench-patch: root required" >&2; exit 77; }
id=${1:-}
[[ $id =~ ^[A-Za-z0-9_-]{1,80}$ ]] || { echo "bench-patch: bad id" >&2; exit 64; }
work=/srv/bench/work/$id
base=/srv/bench/base/$id
for parent in /srv /srv/bench /srv/bench/work /srv/bench/base "$base" "$base/.git"; do
  [[ -d $parent && ! -L $parent && $(/usr/bin/stat -c %u "$parent") == 0 ]] || { echo "bench-patch: unprotected base" >&2; exit 77; }
  mode=$(/usr/bin/stat -c %a "$parent")
  [[ $((8#$mode & 0022)) == 0 ]] || { echo "bench-patch: writable base" >&2; exit 77; }
done
[[ -d $work && ! -L $work ]] || { echo "bench-patch: no copy $id" >&2; exit 66; }
# Attributes may select a configured filter. Ignore every inherited/root
# global registration; only the protected copy's own Git metadata is read.
for name in ${!GIT_@}; do unset "$name"; done
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_ATTR_NOSYSTEM=1
git=(/usr/bin/git --git-dir="$base/.git" --work-tree="$work" -c core.autocrlf=false
  -c core.fsmonitor=false -c core.hooksPath=/dev/null -c core.symlinks=true
  -c core.attributesFile=/dev/null -c diff.external= -c safe.directory="$work")
# Every capture gets a fresh protected index. Removing only its own scratch
# directory clears flags and partial staging on success, error and TERM;
# the pristine commit/index never changes and a failed capture can repeat.
index_dir=$(/usr/bin/mktemp -d "$base/.git/patch-index.XXXXXXXX")
cleanup() {
  local status=$?
  trap - EXIT TERM INT HUP
  [[ -d $base/.git && ! -L $base/.git && $(/usr/bin/stat -c %u "$base/.git") == 0 &&
     $index_dir == "$base/.git/patch-index."* && -d $index_dir && ! -L $index_dir &&
     $(/usr/bin/stat -c %u "$index_dir") == 0 ]] || { echo "bench-patch: cleanup identity refused" >&2; exit 77; }
  /usr/bin/rm -rf -- "$index_dir" || exit 74
  exit "$status"
}
trap cleanup EXIT
trap 'exit 124' TERM INT HUP
export GIT_INDEX_FILE=$index_dir/index
"${git[@]}" read-tree HEAD
# `git add` retains canonical Git semantics for changed/new paths. An
# unchanged committed raw blob must not be renormalized merely because the
# snapshot carries text/eol/encoding attributes: no-op review preserves it.
# Compare modes and a bounded no-filter Git blob hash against protected HEAD.
/usr/bin/python3 -c '
import hashlib, os, stat, subprocess, sys
base, work = sys.argv[1:]
git = subprocess.Popen(["/usr/bin/git", "--git-dir="+base+"/.git", "ls-tree", "-lrz", "HEAD"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE)
root = os.open(work, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    pending = bytearray()
    while chunk := git.stdout.read(8192):
        pending.extend(chunk)
        while 0 in pending:
            raw, _, pending = pending.partition(b"\0")
            # os.open rejects bytearray paths; split immutable bytes instead.
            header, path = bytes(raw).split(b"\t", 1)
            mode, kind, oid, length = header.split()
            if kind != b"blob" or mode not in (b"100644", b"100755"):
                continue
            parts = path.split(b"/")
            if any(part in (b"",b".",b"..",b".git") for part in parts):
                raise ValueError("Unsafe protected baseline path")
            directory = os.dup(root)
            try:
                for part in parts[:-1]:
                    next_dir = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
                    os.close(directory); directory = next_dir
                fd = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
                with os.fdopen(fd, "rb") as source:
                    info = os.fstat(source.fileno())
                    size = int(length)
                    current_mode = b"100755" if info.st_mode & 0o111 else b"100644"
                    if not stat.S_ISREG(info.st_mode) or info.st_size != size or current_mode != mode or size > 256*1024*1024:
                        continue
                    digest = hashlib.sha1() if len(oid)==40 else hashlib.sha256()
                    digest.update(b"blob "+str(size).encode()+b"\0")
                    remaining = size
                    while remaining:
                        data = source.read(min(8192, remaining))
                        if not data: break
                        digest.update(data); remaining -= len(data)
                    if remaining == 0 and not source.read(1) and digest.hexdigest().encode()==oid:
                        sys.stdout.buffer.write(path+b"\0")
            except (FileNotFoundError, NotADirectoryError, OSError):
                # New, deleted, linked or inaccessible candidate paths are
                # handled by ordinary Git staging; never follow a link here.
                pass
            finally:
                os.close(directory)
        if len(pending) > 8192:
            raise ValueError("Protected baseline path exceeds its limit")
    if pending or git.wait() != 0:
        raise ValueError("Protected baseline tree is unavailable")
finally:
    os.close(root)
    if git.poll() is None:
        git.kill(); git.wait()
' "$base" "$work" | "${git[@]}" update-index --assume-unchanged -z --stdin
"${git[@]}" add -A
"${git[@]}" diff --cached --binary --no-ext-diff --no-textconv HEAD
