{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Distill",
  "version": "0.6.2",
  "identifier": "com.levocat.distill",
  "build": {
    "beforeDevCommand": {
      "script": "exec ./node_modules/.bin/vite",
      "cwd": "..",
      "wait": false
    },
    "devUrl": "http://localhost:1520",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Distill",
        "width": 800,
        "height": 600,
        "minWidth": 608,
        "minHeight": 600,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset:",
        "connect-src": "'self' ipc: asset: http://asset.localhost http://ipc.localhost http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:* data: https:",
        "font-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost blob: data:",
        "script-src": "'self' blob: 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/distro/agents/.avatars/**/*",
          "$HOME/**/*",
          "$TEMP/**/*"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["distill"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../distro": "distro",
      "resources/runtime-config.json": "runtime-config.json",
      "../resources/distill-sounds-0.mp3": "distill-sounds-0.mp3",
      "../resources/distill-sounds-1.mp3": "distill-sounds-1.mp3",
      "../resources/distill-sounds-2.mp3": "distill-sounds-2.mp3",
      "../resources/distill-sounds-3.mp3": "distill-sounds-3.mp3",
      "../resources/distill-sounds-4.mp3": "distill-sounds-4.mp3",
      "../resources/distill-sounds-5.mp3": "distill-sounds-5.mp3",
      "../resources/distill-sounds-6.mp3": "distill-sounds-6.mp3"
    },
    "externalBin": ["binaries/distillctl", "binaries/distill-monitor"]
  }
}
